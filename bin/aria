#!/usr/bin/env bash
# A.R.I.A. command-line interface.
#
#   aria capture "idea text"   instant capture to the inbox (no LLM call)
#   aria triage                classify the inbox
#   aria develop [slug]        ideas -> proposed plans
#   aria auto                  triage, then develop new projects (idea -> plan)
#   aria agent <name> "task"   run one agent (role + skills + model tier)
#   aria mission <name> "task" queue a BACKGROUND agent job (survives logout*)
#   aria missions [run]        list missions / drain the queue headless
#   aria skills <cmd>          list|convert|prompt — universal skills pack
#   aria crew <slug>           generate a CrewAI project for a project
#   aria handoff <slug>        generate an OpenHands launch script for a project
#   aria trigger <name> [msg]  fire an allowlisted webhook (n8n, HA, ...)
#   aria llama <cmd>           llama.cpp Vulkan helper (install|get|serve|service)
#   aria status                pipeline dashboard        (headless Claude Code)
#   aria ui [port]             web UI (Claude-style app shell, default :8700)
#   aria app [port]            open A.R.I.A. as a desktop app window
#   aria install-desktop       add A.R.I.A. to your application menu
#   aria install-service       always-on: server at login + hourly auto-pipeline
#   aria uninstall-service     remove the systemd user services
#   aria install-skills        install Anthropic's Agent Skills for Claude Code
#   aria test [--keep]         self-test: run EVERYTHING in a sandbox copy
#   aria doctor                sanity-check the setup
#
# triage/develop/auto run on the engine set in system/config.yml (aria.engine):
# 'ollama' = your local models, 'claude' = headless Claude Code.
# Override per-run: ARIA_ENGINE=claude bin/aria triage
set -euo pipefail

ARIA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INBOX="$ARIA_ROOT/pipeline/00-inbox"

usage() { sed -n '2,28p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

engine() {
  if [ -n "${ARIA_ENGINE:-}" ]; then
    echo "$ARIA_ENGINE"
  else
    sed -n 's/^[[:space:]]*engine:[[:space:]]*\([a-z]*\).*/\1/p' \
      "$ARIA_ROOT/system/config.yml" | head -1 | grep . || echo claude
  fi
}

require_claude() {
  command -v claude >/dev/null 2>&1 || {
    echo "error: claude CLI not found — install Claude Code first" >&2
    echo "       https://code.claude.com/docs" >&2
    echo "       (or set engine: ollama in system/config.yml)" >&2
    exit 1
  }
}

cmd="${1:-}"
shift || true

case "$cmd" in
  capture)
    idea="${*:-}"
    if [ -z "$idea" ]; then
      echo "usage: aria capture \"your idea, rambling welcome\"" >&2
      exit 1
    fi
    mkdir -p "$INBOX"
    stamp_id="$(date +%Y%m%d-%H%M)"
    stamp_iso="$(date -u +%Y-%m-%dT%H:%MZ)"
    # first few words of the idea, kebab-cased, as a filename hint
    snippet="$(printf '%s' "$idea" | tr '[:upper:]' '[:lower:]' \
      | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//' | cut -c1-40 \
      | awk -F- '{print $1"-"$2"-"$3"-"$4}' | sed 's/-*$//')"
    file="$INBOX/$(date +%Y-%m-%d-%H%M)-${snippet:-idea}.md"
    if [ -e "$file" ]; then file="${file%.md}-$RANDOM.md"; fi
    cat > "$file" <<EOF
---
id: $stamp_id
captured: $stamp_iso
status: inbox
type: unclassified
slug:
source: cli
tags: []
---

## Raw capture

$idea

<!-- Sections below are added by the pipeline, never above this line. -->
EOF
    echo "captured -> ${file#"$ARIA_ROOT"/}"
    echo "run 'aria triage' (or /triage in Claude Code) to classify"
    ;;

  triage)
    if [ "$(engine)" = "ollama" ]; then
      exec "$ARIA_ROOT/bin/aria-ollama" triage "$@"
    fi
    require_claude
    cd "$ARIA_ROOT" && claude -p "/triage"
    ;;

  develop)
    if [ "$(engine)" = "ollama" ]; then
      exec "$ARIA_ROOT/bin/aria-ollama" develop "$@"
    fi
    require_claude
    cd "$ARIA_ROOT" && claude -p "/develop ${1:-}"
    ;;

  auto)
    if [ "$(engine)" = "ollama" ]; then
      exec "$ARIA_ROOT/bin/aria-ollama" auto "$@"
    fi
    require_claude
    cd "$ARIA_ROOT" && claude -p "/triage" && claude -p "/develop"
    ;;

  status)
    require_claude
    cd "$ARIA_ROOT" && claude -p "/status"
    ;;

  ui)
    exec python3 "$ARIA_ROOT/bin/aria-ui" "$@"
    ;;

  app)
    exec "$ARIA_ROOT/bin/aria-app" "$@"
    ;;

  install-desktop)
    APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    mkdir -p "$APPS" "${XDG_STATE_HOME:-$HOME/.local/state}"
    cat > "$APPS/aria.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=A.R.I.A.
Comment=Autonomous Reasoning & Intelligence Assistant
Exec=$ARIA_ROOT/bin/aria-app
Icon=$ARIA_ROOT/docs/aria-icon.svg
Terminal=false
Categories=Utility;Development;
StartupWMClass=ARIA
DESKTOP
    update-desktop-database "$APPS" 2>/dev/null || true
    echo "installed -> $APPS/aria.desktop"
    echo "A.R.I.A. is now in your application menu"
    ;;

  install-skills)
    exec "$ARIA_ROOT/bin/aria-install-skills"
    ;;

  test)
    exec python3 "$ARIA_ROOT/bin/aria-test" "$@"
    ;;

  agent)
    name="${1:-}"; shift || true
    task="${*:-}"
    [ -n "$name" ] && [ -n "$task" ] || {
      echo "usage: aria agent <researcher|planner|critic|scribe|...> \"task\"" >&2
      exit 1
    }
    exec python3 -c "
import sys
sys.path.insert(0, '$ARIA_ROOT/bin')
import aria_engine as eng

def emit(ev):
    if ev.get('event') == 'token':
        print(ev['text'], end='', flush=True)
    elif ev.get('log'):
        print('[' + ev['log'] + ']', file=sys.stderr)

eng.run_agent(sys.argv[1], sys.argv[2], emit)
print()
" "$name" "$task"
    ;;

  skills)
    exec python3 "$ARIA_ROOT/bin/aria-skills" "$@"
    ;;

  mission)
    name="${1:-}"; shift || true
    task="${*:-}"
    [ -n "$name" ] && [ -n "$task" ] || {
      echo "usage: aria mission <agent> \"task\"" >&2; exit 1; }
    exec python3 -c "
import sys
sys.path.insert(0, '$ARIA_ROOT/bin')
import aria_engine as eng
p = eng.mission_create(sys.argv[1], sys.argv[2])
print(f'queued -> {p.name}')
print('runs in the background while the A.R.I.A. server is up')
print('(no server? drain headless with: aria missions run)')
" "$name" "$task"
    ;;

  missions)
    sub="${1:-list}"
    exec python3 -c "
import sys
sys.path.insert(0, '$ARIA_ROOT/bin')
import aria_engine as eng
if sys.argv[1] == 'run':
    eng.mission_requeue_stale()
    while True:
        mid = eng.mission_run_next(
            lambda ev: print(ev['log']) if ev.get('log') else None)
        if not mid:
            print('queue empty'); break
else:
    ms = eng.mission_list()
    if not ms: print('no missions yet — queue one: aria mission <agent> \"task\"')
    for m in ms:
        print(f\"{m['status']:8} {m['id']:34} {m['task'][:70]}\")
" "$sub"
    ;;

  crew)
    exec python3 "$ARIA_ROOT/bin/aria-crew" "$@"
    ;;

  handoff)
    exec python3 "$ARIA_ROOT/bin/aria-handoff" "$@"
    ;;

  trigger)
    name="${1:-}"; shift || true
    [ -n "$name" ] || { echo "usage: aria trigger <webhook-name> [message]" >&2; exit 1; }
    exec python3 -c "
import sys
sys.path.insert(0, '$ARIA_ROOT/bin')
import aria_engine as eng
status = eng.trigger_webhook(sys.argv[1], ' '.join(sys.argv[2:]))
print(f'triggered {sys.argv[1]} -> HTTP {status}')
" "$name" "$@"
    ;;

  llama)
    exec "$ARIA_ROOT/bin/aria-llama" "$@"
    ;;

  install-service)
    SYSD="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    mkdir -p "$SYSD"
    cat > "$SYSD/aria.service" <<UNIT
[Unit]
Description=A.R.I.A. server (Claude-style app shell on 127.0.0.1:8700)

[Service]
ExecStart=/usr/bin/env python3 $ARIA_ROOT/bin/aria-ui 8700
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT
    cat > "$SYSD/aria-auto.service" <<UNIT
[Unit]
Description=A.R.I.A. auto-pipeline pass (triage + develop)

[Service]
Type=oneshot
ExecStart=$ARIA_ROOT/bin/aria auto
UNIT
    cat > "$SYSD/aria-auto.timer" <<UNIT
[Unit]
Description=Run the A.R.I.A. pipeline every hour

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
UNIT
    systemctl --user daemon-reload
    systemctl --user enable --now aria.service aria-auto.timer
    echo "aria.service       — server runs at login (http://127.0.0.1:8700)"
    echo "aria-auto.timer    — pipeline self-runs hourly (recursive mode)"
    echo "logs:  journalctl --user -u aria -f"
    echo "pause: systemctl --user stop aria-auto.timer"
    ;;

  uninstall-service)
    systemctl --user disable --now aria.service aria-auto.timer \
      aria-llama.service 'aria-llama-*.service' 2>/dev/null || true
    SYSD="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    rm -f "$SYSD/aria.service" "$SYSD/aria-auto.service" \
      "$SYSD/aria-auto.timer" "$SYSD/aria-llama.service" \
      "$SYSD"/aria-llama-*.service
    systemctl --user daemon-reload
    echo "A.R.I.A. services removed"
    ;;

  doctor)
    ok=0
    for d in pipeline/00-inbox pipeline/01-processing \
             pipeline/02-potential-projects pipeline/knowledge \
             pipeline/archive system/templates .claude/commands .claude/agents; do
      if [ -d "$ARIA_ROOT/$d" ]; then echo "ok   $d"
      else echo "MISS $d"; ok=1; fi
    done
    echo "engine: $(engine)"
    if [ "$(engine)" = "ollama" ]; then
      "$ARIA_ROOT/bin/aria-ollama" check || ok=1
    fi
    command -v claude >/dev/null 2>&1 \
      && echo "ok   claude CLI ($(command -v claude))" \
      || { echo "note claude CLI missing (capture + ollama engine still work)"; }
    exit $ok
    ;;

  ""|-h|--help|help)
    usage
    ;;

  *)
    echo "error: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
