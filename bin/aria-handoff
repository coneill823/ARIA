#!/usr/bin/env python3
"""aria-handoff — generate an OpenHands launch script for a project, so an
autonomous coding agent can execute it against YOUR local models.

  aria handoff <slug>

Writes <project>/openhands.sh: a docker command that mounts the project as
the workspace, points OpenHands' LLM at A.R.I.A.'s `smart` tier, and seeds
it with the requirements as the task. Needs Docker; see
https://github.com/OpenHands/openhands for current image/tag details —
override with OPENHANDS_IMAGE if theirs has moved.

Honest note: generated, not executed — review openhands.sh before running
it, and expect to tune the image tag and model name to your install.
"""

import os
import stat
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import aria_engine as eng  # noqa: E402

TEMPLATE = """#!/usr/bin/env bash
# OpenHands handoff for {slug} — generated by aria-handoff. Review, then run.
# Docs: https://docs.all-hands.dev  /  https://github.com/OpenHands/openhands
set -euo pipefail
cd "$(dirname "$0")"

IMAGE="${{OPENHANDS_IMAGE:-docker.all-hands.dev/all-hands-ai/openhands:latest}}"

# A.R.I.A.'s smart tier at generation time: {backend} / {model}
# (OpenHands reaches the host's model server via host.docker.internal)
LLM_MODEL="{litellm_model}"
LLM_BASE_URL="{base_url_docker}"

exec docker run -it --rm --pull=always \\
  -e SANDBOX_VOLUMES="$(pwd):/workspace:rw" \\
  -e LLM_MODEL="$LLM_MODEL" \\
  -e LLM_BASE_URL="$LLM_BASE_URL" \\
  -e LLM_API_KEY="local" \\
  -e LOG_ALL_EVENTS=true \\
  -v /var/run/docker.sock:/var/run/docker.sock \\
  --add-host host.docker.internal:host-gateway \\
  -p 3000:3000 \\
  "$IMAGE"

# Then open http://localhost:3000 and paste the task below (also in
# openhands-task.md):
"""


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip())
        return 1
    slug = sys.argv[1]

    cfg = eng.config()
    try:
        project = eng._project_dir(slug)
    except ValueError:
        project = None
    if project is None:
        print(f"no project found for slug: {slug}", file=sys.stderr)
        return 1

    smart = eng.resolve_tier("smart", cfg)
    # docker containers can't see "localhost" — rewrite to the host gateway
    base_url_docker = (smart["url"]
                       .replace("localhost", "host.docker.internal")
                       .replace("127.0.0.1", "host.docker.internal"))
    if smart["kind"] == "ollama":
        litellm_model = "ollama/" + smart["model"]
    else:
        litellm_model = "openai/" + smart["model"]
        base_url_docker += "/v1"

    task_lines = [f"Execute the {slug} project in /workspace.",
                  "Work milestone by milestone and verify each against its "
                  "acceptance criteria before moving on."]
    req = None
    for name in ("docs/requirements.md", "requirements.md",
                 "docs/proposed-plan.md", "proposed-plan.md"):
        f = project / name
        if f.is_file():
            req = name
            break
    if req:
        task_lines.append(f"The authoritative spec is /workspace/{req} — "
                          "read it first and stay inside its scope.")
    task = "\n".join(task_lines)

    script = project / "openhands.sh"
    script.write_text(TEMPLATE.format(
        slug=slug, backend=smart["kind"], model=smart["model"],
        litellm_model=litellm_model, base_url_docker=base_url_docker)
        + "".join(f"#   {ln}\n" for ln in task.splitlines()),
        encoding="utf-8")
    script.chmod(script.stat().st_mode | stat.S_IEXEC)
    (project / "openhands-task.md").write_text(task + "\n", encoding="utf-8")

    print(f"generated -> {script}")
    print(f"task      -> {project / 'openhands-task.md'}")
    print("review it, then:  bash openhands.sh   (needs Docker; UI on :3000)")
    print(f"model: {litellm_model} via {base_url_docker}")
    if not os.path.exists("/var/run/docker.sock"):
        print("note: docker not detected on this machine")
    return 0


if __name__ == "__main__":
    sys.exit(main())
