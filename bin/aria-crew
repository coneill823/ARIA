#!/usr/bin/env python3
"""aria-crew — generate a CrewAI project for a promoted (or potential)
A.R.I.A. project, wired to your LOCAL models (no cloud, no keys).

  aria-crew <slug> [--target DIR]

Reads the project's requirements.md (or proposed-plan.md) "Recommended
team" section and emits into <project>/crew/:
  crew.py            agents + tasks, LLM pointed at your local server
  requirements.txt   crewai (install in a venv)
  README.md          how to run it

The generated crew uses whichever backend A.R.I.A.'s `smart` tier points
at. Generating needs nothing installed; RUNNING the crew needs:
  python -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt
"""

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import aria_engine as eng  # noqa: E402


def find_project(slug):
    try:
        return eng._project_dir(slug)
    except ValueError as exc:
        raise SystemExit(str(exc))


def team_from(project):
    for name in ("docs/requirements.md", "requirements.md",
                 "docs/proposed-plan.md", "proposed-plan.md"):
        f = project / name
        if f.is_file():
            text = f.read_text(encoding="utf-8")
            m = re.search(r"##\s*Recommended team\s*\n(.*?)(?=\n##|\Z)",
                          text, re.S)
            if m:
                team = []
                for line in m.group(1).splitlines():
                    lm = re.match(r"\s*[-*]\s*(.+?)\s+[—–-]\s+(.+)", line)
                    if lm:
                        role = re.sub(r"[^\w]+", "_",
                                      lm.group(1).strip().lower()).strip("_")
                        team.append((role, lm.group(2).strip()))
                if team:
                    return team, name
    return [("worker", "executes the project milestones"),
            ("reviewer", "checks the worker's output against requirements")], None


PY_TEMPLATE = '''"""CrewAI crew for {slug} — generated by aria-crew.
Runs entirely against your local model server; edit freely."""

from crewai import Agent, Crew, Task, LLM

# A.R.I.A.'s `smart` tier at generation time: {tier_note}
llm = LLM(
    model="openai/{model}",
    base_url="{base_url}/v1",
    api_key="local",          # local servers ignore the key
    temperature=0.4,
)

{agents}

{tasks}

crew = Crew(agents=[{agent_names}], tasks=[{task_names}], verbose=True)

if __name__ == "__main__":
    print(crew.kickoff())
'''

AGENT_TEMPLATE = '''{var} = Agent(
    role="{role}",
    goal="{goal}",
    backstory="Specialist on the {slug} project. Grounded, concise, "
              "flags anything that needs verification instead of inventing it.",
    llm=llm,
    verbose=True,
)'''

TASK_TEMPLATE = '''{var}_task = Task(
    description=("As the {role} for the {slug} project: {goal} "
                 "Work from docs/requirements.md; stay in scope."),
    expected_output="A markdown work product the project manager can act on.",
    agent={var},
)'''


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if not args:
        print(__doc__.strip())
        return 1
    slug = args[0]
    tdir = None
    if "--target" in sys.argv:
        tdir = Path(sys.argv[sys.argv.index("--target") + 1])

    project = find_project(slug)
    team, source = team_from(project)
    target = eng.resolve_tier("smart")
    out = (tdir or project / "crew")
    out.mkdir(parents=True, exist_ok=True)

    agents, tasks, avars = [], [], []
    for role, goal in team:
        var = role[:24] or "agent"
        if var in avars:
            var = f"{var}_{len(avars)}"
        avars.append(var)
        esc = lambda s: s.replace("\\", "").replace('"', "'")
        agents.append(AGENT_TEMPLATE.format(
            var=var, role=esc(role.replace("_", " ")), goal=esc(goal),
            slug=slug))
        tasks.append(TASK_TEMPLATE.format(
            var=var, role=esc(role.replace("_", " ")), goal=esc(goal),
            slug=slug))

    base_url = target["url"]
    if target["kind"] == "ollama":
        # Ollama exposes an OpenAI-compatible API at the same port
        tier_note = f"ollama model {target['model']}"
    else:
        tier_note = f"OpenAI-compatible server, model {target['model']}"

    (out / "crew.py").write_text(PY_TEMPLATE.format(
        slug=slug, model=target["model"], base_url=base_url,
        tier_note=tier_note,
        agents="\n\n".join(agents), tasks="\n\n".join(tasks),
        agent_names=", ".join(avars),
        task_names=", ".join(f"{v}_task" for v in avars)),
        encoding="utf-8")
    (out / "requirements.txt").write_text("crewai>=0.80\n", encoding="utf-8")
    (out / "README.md").write_text(
        f"# Crew for {slug}\n\nGenerated by `aria-crew` from "
        f"{source or 'a default team'} — regenerate any time.\n\n"
        "```bash\npython -m venv .venv && . .venv/bin/activate\n"
        "pip install -r requirements.txt\npython crew.py\n```\n\n"
        f"Talks to your local model server ({tier_note}); nothing leaves "
        "your machine. Edit crew.py to add tools, reorder tasks, or point "
        "`llm` at a different tier.\n", encoding="utf-8")

    print(f"crew generated -> {out}")
    print(f"team ({source or 'default'}): "
          + ", ".join(r for r, _ in team))
    print("run it:  cd " + str(out)
          + " && python -m venv .venv && . .venv/bin/activate"
          + " && pip install -r requirements.txt && python crew.py")
    return 0


if __name__ == "__main__":
    sys.exit(main())
