    check("openhands handoff", c_handoff)

    def c_voice():
        """Speaking and listening happen on this machine, through a worker
        that keeps the models loaded. (Stand-in engines here; the real ones
        have a check of their own below.)"""
        import io
        import wave
        import aria_voice
        st = eng.voice_status()
        assert st["tts"]["engine"] == "piper" \
            and st["stt"]["engine"] == "faster-whisper", st
        spoken = eng.voice_speak("All systems are operational.")
        with wave.open(io.BytesIO(spoken)) as w:
            assert w.getnframes() > 0, "her voice came back empty"
        heard = eng.transcribe_audio(spoken)
        assert heard.startswith("heard "), heard
        # a worker that dies is started again without the caller noticing
        aria_voice._PROC.kill()
        aria_voice._PROC.wait()
        assert eng.voice_speak("And again.")[:4] == b"RIFF"
        # a WAV written to a pipe carries placeholder sizes (espeak does
        # this): they are put right before a browser has to decode it
        piped = (b"RIFF" + (0x7fffffff).to_bytes(4, "little") + b"WAVEfmt "
                 + (16).to_bytes(4, "little") + b"\x01\x00\x01\x00"
                 + (22050).to_bytes(4, "little") + (44100).to_bytes(4, "little")
                 + b"\x02\x00\x10\x00" + b"data"
                 + (0x7fffffff).to_bytes(4, "little") + b"\0\0" * 100)
        with wave.open(io.BytesIO(aria_voice._fix_wav(piped))) as w:
            assert w.getnframes() == 100
        # with no engine at all she says what to do — not nothing
        keep = os.environ["ARIA_VOICE_WORKER"], os.environ["PATH"]
        nothing = os.path.join(sandbox, "_nothing")
        os.makedirs(nothing, exist_ok=True)
        os.environ["ARIA_VOICE_WORKER"] = os.path.join(nothing, "no-worker")
        aria_voice.reset()
        try:
            os.environ["PATH"] = nothing            # …and no espeak either
            st = eng.voice_status()
            assert not st["tts"]["engine"] and not st["stt"]["engine"]
            assert "aria voice install" in st["tts"]["why"], st
            for call in (lambda: eng.voice_speak("hello"),
                         lambda: eng.transcribe_audio(spoken)):
                try:
                    call()
                    raise AssertionError("spoke or listened with no engine")
                except RuntimeError as exc:
                    assert "aria voice install" in str(exc), exc
        finally:
            os.environ["ARIA_VOICE_WORKER"], os.environ["PATH"] = keep
            aria_voice.reset()
        assert eng.voice_status()["tts"]["engine"] == "piper"
        return ("she speaks and listens through a worker kept warm, a dead "
                "worker is restarted, piped audio is repaired, and with no "
                "engine she says how to get one")
    check("voice — her own voice and ears", c_voice)

    def c_voice_real():
        """The real thing, where `aria voice install` has been run: she
        says a sentence and has to hear it back."""
        import aria_voice
        real = os.path.join(REAL_ROOT, "vendor", "voice")
        if not os.path.isfile(os.path.join(real, "venv", "bin", "python")):
            raise SkipTest("optional — bin/aria voice install (a natural "
                           "voice and local recognition)")
        keep = (aria_voice.VENV, aria_voice.VOICES,
                os.environ.pop("ARIA_VOICE_WORKER"))
        aria_voice.VENV = aria_voice.Path(real) / "venv"
        aria_voice.VOICES = aria_voice.Path(real) / "voices"
        aria_voice.reset()
        try:
            said = "Voice check. A.R.I.A. is online and ready."
            st = eng.voice_status()
            assert st["tts"]["engine"] == "piper", st["tts"]
            heard = eng.transcribe_audio(eng.voice_speak(said),
                                         language="en")
            assert heard, "she spoke but heard nothing back"
        finally:
            aria_voice.VENV, aria_voice.VOICES = keep[0], keep[1]
            os.environ["ARIA_VOICE_WORKER"] = keep[2]
            aria_voice.reset()
        return (f"{st['tts']['voice']} said “{said}” and "
                f"{st['stt']['engine']} heard “{heard}”")
    check("voice — the real engines", c_voice_real, required=False)

    # ---- server-level checks ----------------------------------------
    port = free_port()
    srv = subprocess.Popen(
        [sys.executable, os.path.join(sandbox, "bin", "aria-ui"), str(port)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        env=os.environ.copy())
    procs.append(srv)
    base = f"http://127.0.0.1:{port}"

    def post(path, body):
        req = urllib.request.Request(base + path, method="POST",
                                     data=json.dumps(body).encode())
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                return r.status, r.read().decode()
        except urllib.error.HTTPError as exc:
            return exc.code, exc.read().decode()

    try:
        wait_http(base + "/api/health")

        def c_pages():
            pages = ("/", "/projects", "/board", "/agents", "/orb",
                     "/settings")
            for p in pages:
                with urllib.request.urlopen(base + p, timeout=10) as r:
                    assert r.status == 200, f"{p} -> {r.status}"
                    html = r.read().decode()
                assert 'id="sidebar"' in html, f"{p} lacks the app shell"
            for asset in ("/ui/app.css", "/ui/app.js"):
                with urllib.request.urlopen(base + asset, timeout=10) as r:
                    assert r.status == 200 and len(r.read()) > 500
            return f"{', '.join(pages)} all serve the one app shell"
        check("web pages", c_pages)

        def c_api():
            for p in ("/api/state", "/api/board", "/api/health",
                      "/api/config", "/api/agents", "/api/skills",
                      "/api/projects", "/api/missions"):
                with urllib.request.urlopen(base + p, timeout=15) as r:
                    json.load(r)
            # Settings posts its whole form: only a field that changed is
            # written, and only into the owner's own file
            with urllib.request.urlopen(base + "/api/config", timeout=15) as r:
                shown = json.load(r)
            mine = os.path.join(sandbox, "system", "config.local.yml")
            shipped = os.path.join(sandbox, "system", "config.yml")
            was, default = open(mine).read(), open(shipped).read()
            code, body = post("/api/config", {
                "stt_model": shown["stt_model"],
                "web_search": shown["web_search"],
                "context_tokens": str(shown["context_tokens"]),
                "obsidian_vault": shown["obsidian_vault"],
                "auto_pipeline": shown["auto_pipeline"]})
            assert code == 200 and open(mine).read() == was, \
                "an untouched settings form was written to disk"
            other = "tiny" if shown["stt_model"] != "tiny" else "base"
            code, body = post("/api/config", {"stt_model": other,
                                              "context_tokens": "-1"})
            assert code == 400 and open(mine).read() == was, \
                "a refused settings form was half-saved"
            code, body = post("/api/config", {"stt_model": other})
            assert code == 200 and json.loads(body)["stt_model"] == other
            assert f"stt_model: {other}" in open(mine).read()
            assert open(shipped).read() == default, \
                "Settings wrote into the shipped config.yml"
            eng.config_unset("stt_model")
            # her voice and ears over HTTP (stand-in engines)
            with urllib.request.urlopen(base + "/api/voice", timeout=15) as r:
                voice = json.load(r)
            assert voice["tts"]["engine"] and voice["stt"]["engine"], voice
            req = urllib.request.Request(
                base + "/api/tts", method="POST",
                data=json.dumps({"text": "Good evening."}).encode())
            with urllib.request.urlopen(req, timeout=30) as r:
                spoken = r.read()
                assert r.headers["Content-Type"] == "audio/wav"
            assert spoken[:4] == b"RIFF", "her voice is not a WAV file"
            req = urllib.request.Request(
                base + "/api/stt?lang=en", method="POST", data=spoken,
                headers={"Content-Type": "audio/wav"})
            with urllib.request.urlopen(req, timeout=30) as r:
                assert json.load(r)["text"].startswith("heard ")
            slug = state.get("active")
            if slug:
                with urllib.request.urlopen(
                        f"{base}/api/project?slug={slug}", timeout=15) as r:
                    view = json.load(r)
                assert "roadmap" in view and "milestones" in view["roadmap"]
                with urllib.request.urlopen(
                        f"{base}/api/project/live?slug={slug}",
                        timeout=15) as r:
                    kept = json.load(r)["outputs"]
                if kept:                       # one earlier output, whole
                    with urllib.request.urlopen(
                            f"{base}/api/project/output?slug={slug}&n="
                            f"{kept[0]['n']}", timeout=15) as r:
                        assert "text" in json.load(r)
                with urllib.request.urlopen(
                        f"{base}/api/file/history?slug={slug}"
                        "&path=STATUS.md", timeout=15) as r:
                    assert isinstance(json.load(r)["changes"], list)
            if state.get("diff"):              # previous beside modified
                dslug, dpath, dtask = state["diff"]
                with urllib.request.urlopen(
                        f"{base}/api/file/diff?slug={dslug}&path={dpath}"
                        f"&task={dtask}", timeout=15) as r:
                    diff = json.load(r)
                assert diff["rows"] and diff["before"], diff
                try:
                    urllib.request.urlopen(
                        f"{base}/api/file/diff?slug={dslug}&path=../../"
                        f"system/config.yml&task={dtask}", timeout=15)
                    raise AssertionError("a diff left the project")
                except urllib.error.HTTPError as exc:
                    assert exc.code in (400, 404), exc.code
            if slug:
                for key in ("state", "plan", "assessment", "changes",
                            "report", "activity", "git", "approved"):
                    assert key in view, f"project view lacks {key}"
                with urllib.request.urlopen(
                        f"{base}/api/project/live?slug={slug}", timeout=15) as r:
                    json.load(r)
                # a task that is NOT waiting on the owner cannot be answered
                # (whatever the model planned: never one that is waiting)
                settled = next(
                    (t["id"] for t in view["plan"].get("tasks", [])
                     if not (t.get("needs_human") and t["status"] == "todo")),
                    "t999")
                for route in ("/api/approve-task", "/api/skip-task"):
                    code, body = post(route, {"slug": slug, "id": settled})
                    assert code == 400 and "waiting on you" in body, \
                        (route, code, body[:120])
                # promotion wrote STATUS.md, whatever the model got done
                with urllib.request.urlopen(
                        f"{base}/api/files?slug={slug}", timeout=15) as r:
                    listing = json.load(r)
                assert listing["path"] and any(
                    f["path"] == "STATUS.md" for f in listing["files"]), \
                    "the project's files are not listed"
                with urllib.request.urlopen(
                        f"{base}/api/changes?slug={slug}", timeout=15) as r:
                    assert isinstance(json.load(r)["changes"], list)
                code, body = post("/api/open", {"slug": slug, "how": "folder",
                                                "path": "../../system"})
                assert code == 400 and "outside the project" in body, body
                with urllib.request.urlopen(
                        f"{base}/api/runner?slug={slug}", timeout=15) as r:
                    runner = json.load(r)
                assert "run" in runner and "sandbox" in runner
                # a program is started from the app's own page only
                code, body = post("/api/runner", {"slug": slug,
                                                  "action": "start",
                                                  "cmd": "echo hi"})
                assert code == 403 and "Run tab" in body, (code, body)
                req = urllib.request.Request(
                    base + "/api/runner", method="POST",
                    headers={"Origin": base, "Sec-Fetch-Site": "same-origin"},
                    data=json.dumps({"slug": slug, "action": "start",
                                     "cmd": "echo selftest-ran-it",
                                     "sandboxed": False}).encode())
                with urllib.request.urlopen(req, timeout=15) as r:
                    assert json.load(r)["ok"]
                for _ in range(40):
                    with urllib.request.urlopen(
                            f"{base}/api/runner/output?slug={slug}",
                            timeout=10) as r:
                        ran = json.load(r)
                    if not ran["running"]:
                        break
                    time.sleep(0.1)
                assert "selftest-ran-it" in ran["text"] and ran["exit"] == 0
                try:
                    urllib.request.urlopen(
                        f"{base}/api/file/raw?slug={slug}&path=STATUS.md",
                        timeout=10)
                    raise AssertionError("a non-image was served raw")
                except urllib.error.HTTPError as exc:
                    assert exc.code == 404
                try:
                    urllib.request.urlopen(
                        f"{base}/api/file?slug={slug}&path=../../system/"
                        "config.yml", timeout=10)
                    raise AssertionError("file endpoint left the project")
                except urllib.error.HTTPError as exc:
                    assert exc.code == 404
            try:
                urllib.request.urlopen(
                    base + "/ui/../system/config.yml", timeout=10)
                raise AssertionError("static route left ui/")
            except urllib.error.HTTPError as exc:
                assert exc.code == 404
            # only this machine's own app may call the API: not a page on
            # another site, not another local port, not a rebound hostname
            for headers in ({"Sec-Fetch-Site": "cross-site",
                             "Origin": "https://evil.example"},
                            {"Sec-Fetch-Site": "same-site",
                             "Origin": "http://127.0.0.1:5173"},
                            {"Origin": "http://localhost:5173"},
                            {"Host": "evil.example"}):
                req = urllib.request.Request(
                    base + "/api/capture", method="POST", headers=headers,
                    data=json.dumps({"text": "selftest foreign"}).encode())
                try:
                    urllib.request.urlopen(req, timeout=10)
                    raise AssertionError(f"served a foreign request: {headers}")
                except urllib.error.HTTPError as exc:
                    assert exc.code == 403, (headers, exc.code)
            assert not any("foreign" in f for f in os.listdir(
                os.path.join(sandbox, "pipeline/00-inbox")))
            req = urllib.request.Request(
                base + "/api/state", headers={
                    "Sec-Fetch-Site": "same-origin", "Origin": base})
            with urllib.request.urlopen(req, timeout=10) as r:
                assert r.status == 200
            return "state, board, health, config, agents, skills, " \
                   "projects, project view, files, runner, voice, kept " \
                   "outputs, a file's changes; settings saved to your " \
                   "own file; task answers, path traversal and requests " \
                   "from other sites refused"
        check("api endpoints", c_api)

        def c_chat_http():
            code, body = post("/api/chat", {"messages": [
                {"role": "user",
                 "content": "capture selftest http capture note"}]})
            assert '"action"' in body and "capture" in body, body[:200]
            inbox = os.listdir(os.path.join(sandbox, "pipeline/00-inbox"))
            assert any("selftest" in f for f in inbox)
            code, body = post("/api/chat", {"messages": [
                {"role": "user", "content": "open the projects page"}]})
            assert '"navigate"' in body and '"projects"' in body, body[:200]
            code, body = post("/api/say", {"text": "what are you working on"})
            assert code == 200 and json.loads(body)["reply"], body[:200]
            code, body = post("/api/autopilot",
                              {"slug": fixture_project("selftest-gate-fixture"),
                               "action": "start"})
            assert code == 409 and "needs_approval" in body, (code, body[:120])
            return ("capture and navigation by chat, /api/say answers, "
                    "the gate holds over HTTP")
        check("chat API + spoken commands", c_chat_http)

        def c_app_window():
            """`aria app`: a window of her own. Where Qt WebEngine is
            installed the window is really built (off-screen) and has to
            show the app."""
            app = os.path.join(sandbox, "bin", "aria-app")
            which = subprocess.run([sys.executable, app, "--which"],
                                   capture_output=True, text=True,
                                   timeout=120).stdout.strip()
            assert which in ("qt", "gtk", "webview", "chromium", "browser"), \
                which
            if which != "qt":
                raise SkipTest(
                    f"no Qt WebEngine for this python — `aria app` would "
                    f"use: {which} (for a window of her own: pacman -S "
                    "python-pyqt6-webengine)")
            env = dict(os.environ, QT_QPA_PLATFORM="offscreen",
                       ARIA_APP_SELFTEST="1", ARIA_APP_BACKEND="qt")
            done = subprocess.run([sys.executable, app, str(port)], env=env,
                                  capture_output=True, text=True, timeout=120)
            lines = [ln for ln in done.stdout.splitlines()
                     if ln.startswith("{")]
            assert lines, f"the window reported nothing: {done.stderr[-300:]}"
            seen = json.loads(lines[-1])
            assert seen["loaded"] and seen["shell"] \
                and seen["title"].startswith("A.R.I.A"), seen
            return "a Qt window opened and showed the app shell"
        check("desktop app window", c_app_window, required=False)

        def c_server_version():
            """The server says which version it is running; newer code on
            disk is noticed, and an idle server restarts onto it — found
            by a record that is only believed if the process answers."""
            with urllib.request.urlopen(base + "/api/version", timeout=15) as r:
                v = json.load(r)
            assert v["pid"] == srv.pid and v["code"] and not v["stale"], v
            with urllib.request.urlopen(base + "/api/state", timeout=15) as r:
                assert json.load(r)["version"]["code"] == v["code"]
            found = eng.server_running()
            assert found and found["pid"] == srv.pid and not found["stale"] \
                and not found["managed"], found
            # a left-over record may name a pid that is someone else's by
            # now (here: this very process) — it must not be believed
            record = os.path.join(sandbox, "system", "server.json")
            real = open(record).read()
            with open(record, "w") as f:
                json.dump(dict(json.loads(real), pid=os.getpid()), f)
            assert eng.server_running() is None, \
                "a record naming another process was believed"
            with open(record, "w") as f:
                f.write(real)
            # newer code on disk
            with open(os.path.join(sandbox, "bin", "aria_brain.py"), "a") as f:
                f.write("\n# self-test: newer code than the server runs\n")
            found = eng.server_running()
            assert found and found["stale"], "new code on disk went unnoticed"
            old_state = os.environ.get("XDG_STATE_HOME")
            os.environ["XDG_STATE_HOME"] = os.path.join(sandbox, "_state")
            try:
                how = eng.server_restart(found)
            finally:
                if old_state is None:
                    os.environ.pop("XDG_STATE_HOME")
                else:
                    os.environ["XDG_STATE_HOME"] = old_state
            assert how == "respawned", how
            assert wait_http(base + "/api/health"), "no server after restart"
            with urllib.request.urlopen(base + "/api/version", timeout=15) as r:
                v2 = json.load(r)
            state["respawned"] = v2["pid"]
            assert v2["pid"] != v["pid"] and v2["code"] != v["code"] \
                and not v2["stale"], (v, v2)
            return ("version reported, a left-over record not believed, "
                    "new code on disk noticed and restarted onto")
        check("version + restart onto new code", c_server_version)
    finally:
        for p in procs:
            p.terminate()
        if state.get("respawned"):
            try:
                os.kill(state["respawned"], 15)
            except OSError:
                pass

    # ---- machine integration (informational) ------------------------
    def c_install():
        found = []
        apps = os.path.expanduser("~/.local/share/applications/aria.desktop")
        unit = os.path.expanduser("~/.config/systemd/user/aria.service")
        if os.path.isfile(apps):
            found.append("desktop entry")
        if os.path.isfile(unit):
            found.append("systemd service")
        if not found:
            raise SkipTest("not installed — run ./install.sh")
        return ", ".join(found)
    check("desktop/service install", c_install, required=False)

    def c_update():
        """`aria update` against a local stand-in for GitHub: the new
        version comes in, hand edits to config.yml move to the owner's own
        file, and the running server is not restarted under autopilot."""
        if not shutil.which("git"):
            raise SkipTest("git not installed")
        import re
        top = os.path.join(sandbox, "_update")
        dev, user = os.path.join(top, "dev"), os.path.join(top, "user")
        origin = os.path.join(top, "origin.git")
        shim = os.path.join(top, "shim")
        asked = os.path.join(top, "systemctl.log")
        os.makedirs(shim)
        # your real server must not be restarted by a self-test: this
        # stand-in answers "active" and only records what it is asked
        with open(os.path.join(shim, "systemctl"), "w") as f:
            f.write(f'#!/bin/sh\necho "$@" >> "{asked}"\nexit 0\n')
        os.chmod(os.path.join(shim, "systemctl"), 0o755)
        env = dict(os.environ, GIT_AUTHOR_NAME="selftest",
                   GIT_AUTHOR_EMAIL="selftest@localhost",
                   GIT_COMMITTER_NAME="selftest",
                   GIT_COMMITTER_EMAIL="selftest@localhost",
                   GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1",
                   PATH=shim + os.pathsep + os.environ["PATH"])

        def run(*argv, cwd, ok=True):
            r = subprocess.run(list(argv), cwd=cwd, env=env,
                               capture_output=True, text=True, timeout=120)
            assert not ok or r.returncode == 0, \
                f"{' '.join(argv)}: {r.stdout} {r.stderr}"
            return r

        def text(*parts):
            with open(os.path.join(*parts), encoding="utf-8") as f:
                return f.read()

        def put(body, *parts):
            with open(os.path.join(*parts), "w", encoding="utf-8") as f:
                f.write(body)

        shutil.copytree(os.path.join(REAL_ROOT, "bin"),
                        os.path.join(dev, "bin"),
                        ignore=shutil.ignore_patterns("__pycache__"))
        os.makedirs(os.path.join(dev, "system"))
        shutil.copy2(os.path.join(REAL_ROOT, "system", "config.yml"),
                     os.path.join(dev, "system", "config.yml"))
        shutil.copy2(os.path.join(REAL_ROOT, ".gitignore"),
                     os.path.join(dev, ".gitignore"))
        run("git", "init", "-q", cwd=dev)
        run("git", "symbolic-ref", "HEAD", "refs/heads/main", cwd=dev)
        run("git", "add", "-A", cwd=dev)
        run("git", "commit", "-qm", "version one", cwd=dev)
        run("git", "clone", "-q", "--bare", dev, origin, cwd=top)
        run("git", "remote", "add", "origin", origin, cwd=dev)
        run("git", "clone", "-q", origin, user, cwd=top)

        # the owner edits the shipped settings by hand; upstream moves on
        shipped = text(user, "system/config.yml")
        default = eng._scalars(shipped).get("stt_model") or "base"
        mine = "medium" if default != "medium" else "small"
        put(re.sub(r"(?m)^([ \t]*)stt_model:.*$",
                   rf"\g<1>stt_model: {mine}", shipped, count=1),
            user, "system/config.yml")
        put(shipped + "\n  # new in version two\n  brand_new: 1\n",
            dev, "system/config.yml")
        put("version two\n", dev, "NEWS")
        run("git", "add", "-A", cwd=dev)
        run("git", "commit", "-qm", "version two", cwd=dev)
        run("git", "push", "-q", "origin", "main", cwd=dev)

        # autopilot is mid-task in the owner's copy
        busy = os.path.join(user, "active-projects", "busy-project")
        os.makedirs(os.path.join(busy, "autopilot"))
        put("---\napproved: true\n---\n", busy, "requirements.md")
        put(json.dumps({"status": "running", "iteration": 1}),
            busy, "autopilot", "state.json")

        r = run(os.path.join(user, "bin", "aria"), "update", cwd=user)
        assert "version two" in r.stdout, r.stdout
        assert text(user, "system/config.yml") == text(dev, "system/config.yml"), \
            "config.yml is not the new version's"
        assert f"stt_model: {mine}" in text(user, "system/config.local.yml"), \
            "the hand edit was not carried into config.local.yml"
        kept = [f for f in os.listdir(os.path.join(user, "system"))
                if f.startswith("config.backup-")]
        assert len(kept) == 1 and f"stt_model: {mine}" in \
            text(user, "system", kept[0]), "no backup of the edited file"
        assert os.path.isfile(os.path.join(user, "NEWS"))
        assert run("git", "status", "--porcelain", "--", "system",
                   cwd=user).stdout == "", "her own files show up in git"
        assert "OLD version" in r.stdout and "busy-project" in r.stdout, r.stdout
        assert "restart" not in text(asked), \
            "restarted the server under a running autopilot"
        r = run(os.path.join(user, "bin", "aria"), "update", cwd=user)
        assert "already up to date" in r.stdout, r.stdout

        # a hand-edited file the new version also changes: stop, touch nothing
        put("version three\n", dev, "NEWS")
        run("git", "commit", "-qam", "version three", cwd=dev)
        run("git", "push", "-q", "origin", "main", cwd=dev)
        put("my notes\n", user, "NEWS")
        r = run(os.path.join(user, "bin", "aria"), "update", cwd=user, ok=False)
        assert r.returncode == 1 and "git stash" in r.stderr, (r.stdout, r.stderr)
        assert text(user, "NEWS") == "my notes\n", "a hand edit was overwritten"
        # with nothing in flight, the new version is restarted into
        put("version two\n", user, "NEWS")
        put(json.dumps({"status": "stopped"}), busy, "autopilot", "state.json")
        r = run(os.path.join(user, "bin", "aria"), "update", cwd=user)
        assert "restart aria.service" in text(asked) \
            and "restarted the server" in r.stdout, r.stdout
        return ("new version in, hand-edited settings carried over with a "
                "backup, a clash stops it untouched, no restart under a "
                "running autopilot")
    check("update — new version, your settings kept", c_update)

    # ---- summary -----------------------------------------------------
    fails = [r for r in results if r[1] == "FAIL"]
    warns = [r for r in results if r[1] == "WARN"]
    skips = [r for r in results if r[1] == "SKIP"]
    print(f"\n{'='*62}")
    print(f"{len(results)} checks: "
          f"{GREEN}{len(results)-len(fails)-len(warns)-len(skips)} passed{END}"
          + (f", {RED}{len(fails)} failed{END}" if fails else "")
          + (f", {YELLOW}{len(warns)} warnings{END}" if warns else "")
          + (f", {len(skips)} skipped" if skips else ""))
    for name, _, detail in fails:
        print(f"  {RED}✗{END} {name}: {detail}")
    if MOCK and not fails:
        print(f"{DIM}mock run: the machinery works. Run `aria test` without "
              f"--mock to prove your models too.{END}")
    if KEEP:
        print(f"sandbox kept: {sandbox}")
    else:
        shutil.rmtree(sandbox, ignore_errors=True)
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
