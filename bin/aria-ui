#!/usr/bin/env python3
"""A.R.I.A. web UI server — Claude-style app shell at /, pipeline board at
/board, orb focus mode at /orb, agents at /agents.

  aria-ui [port]     default port 8700, binds to 127.0.0.1 only

Stdlib only. Endpoints:
  GET  /  /board  /orb  /agents             the app pages
  GET  /api/board     pipeline state as JSON
  GET  /api/health    backend/tier reachability
  GET  /api/agents    agent definitions (name, role, skills, model tier)
  GET  /api/skills    universal skills index
  GET  /api/note?path=<repo-relative .md>   note content
  GET  /api/run?stage=triage|develop|auto   Server-Sent Events stream
       (&file=<inbox note> scopes triage/auto, &slug=<slug> scopes develop)
  POST /api/capture   {"text": "..."} -> new inbox note
  POST /api/refine    {"slug", "feedback"} -> idea goes back to processing
  POST /api/export    {"slug"} -> publish project into the Obsidian vault
  POST /api/chat      {"messages", "skill"?} -> streamed reply / action
  POST /api/agent     {"name", "task"} -> streamed agent run
  POST /api/stt       raw audio body -> {"text"} via local faster-whisper
"""

import json
import sys
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import aria_engine as eng  # noqa: E402

UI_DIR = eng.ROOT / "ui"
PAGES = {"/": UI_DIR / "index.html", "/board": UI_DIR / "board.html",
         "/orb": UI_DIR / "orb.html", "/agents": UI_DIR / "agents.html"}
RUN_LOCK = threading.Lock()  # one engine run at a time
AUDIO_SUFFIX = {"audio/webm": ".webm", "audio/ogg": ".ogg",
                "audio/wav": ".wav", "audio/mp4": ".m4a"}


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    # ------------------------------------------------------------ helpers

    def send_json(self, obj, code=200):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def send_sse_headers(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "close")
        self.end_headers()

    # ------------------------------------------------------------ routes

    def do_GET(self):
        url = urllib.parse.urlparse(self.path)
        query = urllib.parse.parse_qs(url.query)

        if url.path in PAGES:
            data = PAGES[url.path].read_bytes()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        elif url.path == "/api/board":
            self.send_json(eng.board())
        elif url.path == "/api/health":
            self.send_json(eng.health())
        elif url.path == "/api/config":
            cfg = eng.config()
            self.send_json({"obsidian_vault": cfg["obsidian_vault"],
                            "auto_pipeline": cfg["auto_pipeline"],
                            "model": cfg["model"],
                            "tiers": {t: (eng.resolve_tier(t, cfg)["kind"]
                                          + "/" +
                                          eng.resolve_tier(t, cfg)["model"])
                                      for t in ("fast", "smart", "deep")},
                            "stt_model": cfg["stt_model"]})
        elif url.path == "/api/missions":
            self.send_json({"missions": eng.mission_list()})
        elif url.path == "/api/agents":
            self.send_json({"agents": [
                {k: a[k] for k in ("name", "role", "skills", "model", "path")}
                for a in eng.list_agents()]})
        elif url.path == "/api/skills":
            idx = eng.ROOT / "skills" / "index.json"
            if idx.is_file():
                self.send_json({"skills":
                                json.loads(idx.read_text(encoding="utf-8"))})
            else:
                self.send_json({"skills": [{"name": n, "description": "",
                                            "execution": "claude-only"}
                                           for n in eng.list_skill_names()]})
        elif url.path == "/api/note":
            rel = (query.get("path") or [""])[0]
            target = (eng.ROOT / rel).resolve()
            if (not str(target).startswith(str(eng.ROOT) + "/")
                    or target.suffix != ".md" or not target.is_file()):
                self.send_json({"error": "not found"}, 404)
                return
            self.send_json({"path": rel,
                            "content": target.read_text(encoding="utf-8")})
        elif url.path == "/api/run":
            self.run_stage((query.get("stage") or [""])[0],
                           file=(query.get("file") or [""])[0],
                           slug=(query.get("slug") or [""])[0])
        else:
            self.send_json({"error": "not found"}, 404)

    def do_POST(self):
        url = urllib.parse.urlparse(self.path)
        length = int(self.headers.get("Content-Length") or 0)
        if url.path == "/api/stt":  # raw audio, not JSON
            try:
                suffix = AUDIO_SUFFIX.get(
                    (self.headers.get("Content-Type") or "").split(";")[0],
                    ".webm")
                text = eng.transcribe_audio(self.rfile.read(length), suffix)
                self.send_json({"text": text})
            except RuntimeError as exc:   # faster-whisper not installed
                self.send_json({"error": str(exc)}, 501)
            except Exception as exc:
                self.send_json({"error": str(exc)}, 400)
            return
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
            if url.path == "/api/capture":
                path = eng.capture_note(str(body.get("text", "")), source="ui")
                self.send_json({"ok": True, "file": path.name,
                                "path": str(path.relative_to(eng.ROOT))})
            elif url.path == "/api/refine":
                dest = eng.refine(str(body.get("slug", "")),
                                  str(body.get("feedback", "")))
                self.send_json({"ok": True, "slug": dest.stem,
                                "path": str(dest.relative_to(eng.ROOT))})
            elif url.path == "/api/export":
                index = eng.export_obsidian(str(body.get("slug", "")))
                self.send_json({"ok": True, "path": str(index)})
            elif url.path == "/api/config":
                for key in ("obsidian_vault", "auto_pipeline",
                            "fast", "smart", "deep", "stt_model"):
                    if key in body:
                        eng.config_set(key, str(body[key]).strip())
                cfg = eng.config()
                self.send_json({"ok": True,
                                "obsidian_vault": cfg["obsidian_vault"],
                                "auto_pipeline": cfg["auto_pipeline"]})
            elif url.path == "/api/chat":
                self.chat(body)
            elif url.path == "/api/agent":
                self.agent(body)
            else:
                self.send_json({"error": "not found"}, 404)
        except Exception as exc:
            self.send_json({"error": str(exc)}, 400)

    # ------------------------------------------------------------ voice chat

    def chat(self, body):
        messages = body.get("messages") or []
        if not isinstance(messages, list) or not messages:
            self.send_json({"error": "messages required"}, 400)
            return
        last = str(messages[-1].get("content", ""))

        self.send_sse_headers()

        def emit(ev):
            try:
                self.wfile.write(b"data: " + json.dumps(ev).encode() + b"\n\n")
                self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                pass

        try:
            intent = eng.detect_intent(last)
            if intent and intent["action"] == "capture":
                path = eng.capture_note(intent["text"], source="voice")
                auto = eng.config()["auto_pipeline"]
                say = f"Captured — filed as {path.name}."
                if auto:
                    say += " Auto-pipeline is on, so I'm triaging it now."
                emit({"event": "action",
                      "action": "auto" if auto else "capture",
                      "file": path.name, "say": say})
            elif intent and intent["action"] == "use-skill":
                try:
                    eng.skill_text(intent["name"])  # validates it exists
                    emit({"event": "action", "action": "use-skill",
                          "name": intent["name"],
                          "say": f"Skill {intent['name']} loaded — it stays "
                                 "active until you say 'drop skill'."})
                except ValueError as exc:
                    emit({"event": "action", "action": "drop-skill",
                          "say": str(exc)})
            elif intent and intent["action"] == "drop-skill":
                emit({"event": "action", "action": "drop-skill",
                      "say": "Skill unloaded."})
            elif intent and intent["action"] == "webhook":
                try:
                    status = eng.trigger_webhook(intent["name"],
                                                 intent.get("message", ""))
                    emit({"event": "action", "action": "webhook",
                          "name": intent["name"],
                          "say": f"Triggered {intent['name']} — "
                                 f"it answered {status}."})
                except Exception as exc:
                    emit({"event": "action", "action": "webhook",
                          "say": f"Couldn't trigger {intent['name']}: {exc}"})
            elif intent and intent["action"] == "no-web":
                emit({"event": "action", "action": "no-web",
                      "say": "Straight answer: I run fully local with no "
                             "web access, so I can't search or fetch live "
                             "data — and I won't pretend to. Say 'capture "
                             "<the idea>' and the pipeline will draft a "
                             "plan with research leads marked unverified; "
                             "for sourced web research, run /develop in a "
                             "Claude Code session."})
            elif intent and intent["action"] == "explain-commands":
                emit({"event": "action", "action": "explain-commands",
                      "say": "That's not a command I have. "
                             + eng.known_commands_text()})
            elif intent and intent["action"] == "mission":
                try:
                    path = eng.mission_create(intent["name"], intent["task"])
                    emit({"event": "action", "action": "mission",
                          "name": intent["name"], "id": path.stem,
                          "say": f"Mission queued for the {intent['name']} — "
                                 "it runs in the background even if you "
                                 "close this tab. Ask me about missions "
                                 "anytime, or watch the Agents page."})
                except ValueError as exc:
                    emit({"event": "action", "action": "mission",
                          "say": str(exc)})
            elif intent and intent["action"] == "agent":
                emit({"event": "action", "action": "agent",
                      "name": intent["name"], "task": intent["task"],
                      "say": f"Passing that to the {intent['name']} agent."})
            elif intent:
                emit({"event": "action", "action": intent["action"],
                      "say": f"On it — running {intent['action']} now."})
            else:
                eng.converse(messages, skill=body.get("skill") or None,
                             on_token=lambda t: emit({"event": "token",
                                                      "text": t}))
        except Exception as exc:
            emit({"event": "error", "log": str(exc)})
        emit({"event": "done"})

    def agent(self, body):
        name = str(body.get("name", "")).strip()
        task = str(body.get("task", "")).strip()
        if not name or not task:
            self.send_json({"error": "name and task required"}, 400)
            return
        if not RUN_LOCK.acquire(blocking=False):
            self.send_json({"error": "a run is already in progress"}, 409)
            return
        try:
            self.send_sse_headers()

            def emit(ev):
                try:
                    self.wfile.write(b"data: " + json.dumps(ev).encode()
                                     + b"\n\n")
                    self.wfile.flush()
                except (BrokenPipeError, ConnectionResetError):
                    pass

            try:
                eng.run_agent(name, task, emit)
            except Exception as exc:
                emit({"event": "error", "log": str(exc)})
            emit({"event": "done"})
        finally:
            RUN_LOCK.release()

    # ------------------------------------------------------------ engine

    def run_stage(self, stage, file="", slug=""):
        if stage not in ("triage", "develop", "auto"):
            self.send_json({"error": "stage must be triage, develop or auto"}, 400)
            return
        if not RUN_LOCK.acquire(blocking=False):
            self.send_json({"error": "a run is already in progress"}, 409)
            return
        try:
            self.send_sse_headers()
            dead = False

            def emit(ev):
                nonlocal dead
                if dead:
                    return  # keep the pipeline consistent even if the tab closed
                try:
                    self.wfile.write(b"data: " + json.dumps(ev).encode() + b"\n\n")
                    self.wfile.flush()
                except (BrokenPipeError, ConnectionResetError):
                    dead = True

            files = [f"pipeline/00-inbox/{Path(file).name}"] if file else None
            try:
                if stage == "triage":
                    eng.triage_run(emit, files=files)
                elif stage == "auto":
                    eng.auto_run(emit, files=files)
                else:
                    eng.develop_run(emit, slugs=[slug] if slug else None)
            except Exception as exc:
                emit({"event": "error", "log": f"engine crashed: {exc}"})
            emit({"event": "done"})
        finally:
            RUN_LOCK.release()


def mission_worker():
    """Background executor: drains the mission queue one job at a time,
    forever. Lives inside the always-on server, so missions keep running
    with every browser tab closed. Pipeline runs (RUN_LOCK) are not
    blocked — a days-long giant-model mission must not freeze triage."""
    for mid in eng.mission_requeue_stale():
        print(f"mission {mid} was interrupted by a restart — requeued")
    while True:
        try:
            ran = eng.mission_run_next(
                lambda ev: print("mission:", ev["log"])
                if ev.get("log") else None)
        except Exception as exc:
            print("mission worker error:", exc)
            ran = None
        if not ran:
            time.sleep(20)


def main():
    port = int(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].isdigit() else 8700
    threading.Thread(target=mission_worker, daemon=True).start()
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print(f"A.R.I.A. UI -> http://127.0.0.1:{port}  (Ctrl+C to stop)")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


if __name__ == "__main__":
    main()
