#!/usr/bin/env python3
"""aria-mock-llm — a stand-in model server for testing A.R.I.A. without a GPU.

  aria-mock-llm [port]        default 11435, binds 127.0.0.1

Speaks enough of Ollama's API (/api/tags, /api/chat with streaming) and of
the OpenAI API (/v1/models, /v1/chat/completions) for the whole engine to
run against it. It recognises which stage is asking from the prompt and
answers with a small, deterministic, well-formed reply — a triage verdict,
a plan, a batch of autopilot tasks, a file, a review verdict — so the
plumbing can be exercised end to end in seconds: `aria test --mock`.

It is a test double, not a model: the "work" it produces is filler.

Steering the mock from a test: put a marker in a task title —
  [fail]         the reviewer always rejects it
  [flaky]        rejected on the first attempt, accepted on the second
  [stubborn]     rejected on the first two attempts, accepted on the third
— or in a chat message —
  [slow]         the answer starts only after MOCK_SLOW_SECONDS (default 6),
                 like a model that is busy with something else
  [syntaxerror]  the first attempt writes Python that does not parse
Environment:
  MOCK_BATCHES   how many build batches the planner offers (default 2)
  MOCK_DELAY     seconds between streamed chunks (default 0)
  MOCK_GATE      the first batch also holds a task marked needs_human and
                 one that depends on it ("all": every task of that batch
                 is marked, the way an over-cautious model plans)
  MOCK_REPEAT    the second batch proposes the first batch's work again
  MOCK_HARD      the planner marks one first-batch task as "hard"
  MOCK_NO_ROADMAP  the planner cannot produce a roadmap (answers nonsense)
  MOCK_NO_PLAN   the planner answers in prose where a plan was asked for
  MOCK_NO_BUSINESS  the business plan comes back as one useless sentence
  MOCK_NO_ACTIONS   "who does what" comes back as prose, not JSON
  MOCK_NO_REACHED  the planner never reports a milestone as reached
  MOCK_FAIL_ALL  the reviewer rejects everything (every batch is a dry one)
  MOCK_LOADED    comma-separated models Ollama "has in memory" (/api/ps)
  MOCK_LOAD_SECONDS  /health answers 503 "Loading model" this long after
                 start, like llama-server loading a giant
  MOCK_REFINE_BREAKS  the first attempt at a refinement changes what the
                 code does (the project's tests must catch it)
  MOCK_THINKING  behave like a reasoning model (qwen3, deepseek-r1): reason
                 for this many tokens before every answer — streamed as
                 `message.thinking` on Ollama's API and as
                 `reasoning_content` on the OpenAI one — unless the request
                 says "think": false. Then the window is real: prompt,
                 reasoning and answer share num_ctx, and an answer that
                 does not fit is cut off where the room ran out.
  MOCK_WINDOW    the window of the OpenAI-side server (a stand-in giant),
                 which takes no num_ctx from the request
  MOCK_NO_THINK_SWITCH  answer a request that carries "think" with HTTP
                 400, like a server too old to know the word
"""

import json
import os
import re
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

MODELS = [("llama3.1:8b", 4_900_000_000), ("qwen3:30b", 18_000_000_000),
          ("mock-coder:14b", 9_000_000_000)]
STATE = {"plans": {}, "attempts": {}, "audits": {}, "calls": [],
         # MOCK_LOADED: the models "in memory", as Ollama's /api/ps reports
         "loaded": [n for n in os.environ.get("MOCK_LOADED", "").split(",")
                    if n], "released": []}
DELAY = float(os.environ.get("MOCK_DELAY", "0") or 0)
BATCHES = int(os.environ.get("MOCK_BATCHES", "2") or 2)
LOAD_SECONDS = float(os.environ.get("MOCK_LOAD_SECONDS", "0") or 0)
THINKING = int(os.environ.get("MOCK_THINKING", "0") or 0)
WINDOW = int(os.environ.get("MOCK_WINDOW", "0") or 0)
STARTED = time.time()
CHARS_PER_TOKEN = 3.5           # the mock's "tokenizer"
MUSING = ("Let me think about what is being asked here, what already "
          "exists, and what a good answer has to contain. ")


def tokens(text):
    return int(len(text) / CHARS_PER_TOKEN) + 1


def fit(prompt_chars, text, window, limit, think):
    """What a reasoning model with a real window makes of a request: how
    much it reasons, how much of its answer fits, and how it ended.
    Returns (reasoning, answer, done_reason, prompt_tokens, written)."""
    read = int(prompt_chars / CHARS_PER_TOKEN) + 1
    if not THINKING:
        wrote = tokens(text)
        if window:                      # an ordinary model: it simply fits
            read = min(read, max(0, window - wrote - 1))
        return "", text, "stop", read, wrote
    room = max(0, window - read) if window else 10 ** 9
    if limit:
        room = min(room, int(limit))
    mused = min(THINKING, room) if think else 0
    reasoning = (MUSING * (mused * 4 // len(MUSING) + 1))[:mused * 4]
    left = room - mused
    want = tokens(text)
    if want <= left:
        return reasoning, text, "stop", read, mused + want
    cut = text[:int(left * CHARS_PER_TOKEN)]
    return reasoning, cut, "length", read, mused + left


def _slug(text, default="project"):
    m = re.search(r'PROJECT:?\s*"?([\w.-]+)', text) or \
        re.search(r'inside the project "([\w.-]+)"', text)
    return m.group(1) if m else default


_COMMON = set("a an the my our your that this it to of for by in on and or "
              "with build make create small little new some i we want need "
              "would like which what when they were was is are be".split())


def _kebab(text, limit=5):
    words = [w for w in re.sub(r"[^a-z0-9 ]", " ", text.lower()).split()
             if w not in _COMMON]
    return "-".join(words[:limit]) or "untitled"


# ------------------------------------------------------------ the answers

def triage(prompt):
    note = prompt.split("Classify this note:")[-1]
    note = re.sub(r"<!--.*?-->", "", note.split("## Raw capture")[-1],
                  flags=re.S).strip().lower()
    slug = _kebab(note, 4)
    if len(note.split()) < 3:
        return {"type": "unclear", "confidence": 0.3, "slug": slug,
                "list": "tasks", "reasoning": "too little to go on",
                "questions": ["What did you want done with this?"]}
    if re.search(r"\b(someday|one day|eventually)\b", note):
        kind = "someday"
    elif re.search(r"\b(tiktok|video|post|reel|blog)\b", note):
        kind = "content"
    elif re.search(r"\b(build|app|tool|website|plan|system|make|create|"
                   r"automate|planner)\b", note):
        kind = "project"
    elif re.search(r"\b(buy|milk|eggs|bread|grocer)", note):
        return {"type": "task", "confidence": 0.93, "slug": slug,
                "list": "grocery", "reasoning": "a shopping item"}
    elif re.search(r"\b(email|call|book|remind|pay)\b", note):
        kind = "task"
    else:
        kind = "note"
    return {"type": kind, "confidence": 0.9, "slug": slug, "list": "tasks",
            "reasoning": f"reads as a {kind}"}


def proposed_plan(prompt):
    idea = prompt.split("Write the proposed plan for this idea:")[-1]
    idea = idea.split("---\nResearch findings")[0]
    idea = re.sub(r"<!--.*?-->", "", idea.split("## Raw capture")[-1],
                  flags=re.S).strip()
    name = " ".join(_kebab(idea, 4).split("-")).title()
    return f"""# Proposed plan: {name}

> **Pitch:** A small, focused tool that does what the note asks for.

## What we're building

{' '.join(idea.split())[:240]}

## Recommended approach

A single Python package with a command-line entry point. It is the smallest
thing that works and needs no services.

## Scope

**In:**
- the core function
- a command-line interface
- tests

**Out (for v1):**
- a web interface
- cloud sync

## Milestones

| # | Milestone | Rough effort | Done means |
|---|---|---|---|
| 1 | Design | 2h | a design note exists |
| 2 | Core | 4h | the core function works on sample input |
| 3 | Tests and docs | 3h | tests exist and the README explains usage |

## Recommended team

- developer — builds the tool and its tests
- reviewer — checks the work against the requirements

## Decisions needed from you

- Which platforms matter first?

## Risks

- Scope creep — keep v1 to the three milestones.
"""


def research(prompt):
    cite = " [1]" if "[1]" in prompt else ""
    return f"""## Prior art

Several tools cover parts of this{cite}; none match the exact workflow.

## Tools and building blocks

A scripting language with a good standard library is enough.

## Audience

People with the same recurring chore.

## Feasibility

A weekend for a first version; the hard part is messy real-world input.

## Open questions

- How much of this already exists and is good enough?
"""


def assessment(prompt):
    slug = _slug(prompt)
    return f"""## What needs to be done
- A design note for {slug}
- The core module and its command-line entry point
- Tests for the core behaviour
- A README that explains how to use it

## What I can do with what I have
- planner drafts the design; coder writes the module and the tests on the
  smart model; scribe writes the README on the fast model
- every Python file is syntax-checked before it is kept

## Gaps and risks
- I cannot run the tests — the owner should run them once
- No real sample data — the code is written against invented examples

## Approach
1. Design note
2. Core module
3. Tests
4. README
"""


def plan_batch(prompt):
    slug = _slug(prompt)
    n = STATE["plans"].get(slug, 0)
    if "AN AUDIT FOUND THESE GAPS" in prompt:
        tasks = [{"id": "g1", "title": "Close the audit gap",
                  "detail": "Write docs/gap-closure.md addressing the gap "
                            "the audit named.",
                  "why": "the audit found a requirement unmet",
                  "agent": "scribe", "skills": [], "model": "fast",
                  "phase": "hardening", "est_hours": 1, "depends_on": [],
                  "reads": [], "research": False,
                  "done_when": "docs/gap-closure.md exists"}]
    elif "MODE: the stated goal is met" in prompt:
        key = slug + "#improve"
        if STATE["plans"].get(key):
            return {"tasks": [], "project_complete": True}
        STATE["plans"][key] = 1
        tasks = [{"id": "i1", "title": "Add a troubleshooting section",
                  "detail": "Extend README.md with a troubleshooting "
                            "section.",
                  "why": "the goal is met; this is the most useful polish",
                  "agent": "scribe", "skills": [], "model": "fast",
                  "phase": "polish", "est_hours": 1, "depends_on": [],
                  "reads": ["README.md"], "research": False,
                  "done_when": "README.md has a Troubleshooting heading"}]
    elif n == 0:
        tasks = [
            {"id": "a", "title": "Write the design note",
             "detail": "Produce docs/design.md covering inputs, outputs "
                       "and the module layout.",
             "why": "everything else builds on an agreed design",
             "agent": "planner", "skills": [], "model": "",
             "phase": "design", "est_hours": 2, "depends_on": [],
             "reads": [], "research": "web access is OFF" not in prompt,
             "done_when": "docs/design.md describes inputs, outputs and "
                          "layout"},
            {"id": "b", "title": "Implement the core module",
             "detail": "Write src/core.py with a run() function following "
                       "docs/design.md.",
             "why": "the core is the product; the coder is the right hands",
             "agent": "coder", "skills": [], "model": "smart",
             "phase": "build", "est_hours": 4, "depends_on": ["a"],
             "reads": [], "research": False,
             "done_when": "src/core.py defines run() and parses"},
            {"id": "c", "title": "Write tests for the core module",
             "detail": "Write tests/test_core.py exercising run().",
             "why": "the work cannot be run here, so tests are the owner's "
                    "safety net",
             "agent": "coder", "skills": [], "model": "",
             "phase": "build", "est_hours": 3, "depends_on": ["b"],
             "reads": [], "research": False,
             "done_when": "tests/test_core.py has at least two tests"},
            {"id": "d", "title": "Write the README",
             "detail": "Write README.md: what it is, how to run it.",
             "why": "simple prose — the fast model is enough",
             "agent": "scribe", "skills": [], "model": "fast",
             "phase": "docs", "est_hours": 1, "depends_on": ["b"],
             "reads": [], "research": False,
             "done_when": "README.md explains how to run the tool"},
        ]
    elif n < BATCHES:
        suffix = "" if n == 1 else f" (pass {n})"
        tasks = [
            {"id": "e", "title": "Add the command-line entry point" + suffix,
             "detail": "Write src/cli.py that calls run() from src/core.py.",
             "why": "the core needs a way to be invoked",
             "agent": "coder", "skills": [], "model": "",
             "phase": "build", "est_hours": 2, "depends_on": [],
             "reads": ["src/core.py"], "research": False,
             "done_when": "src/cli.py has a main() that calls run()"},
            {"id": "f", "title": "Document the command line" + suffix,
             "detail": "Update README.md with a usage section for the CLI.",
             "why": "the new entry point must be documented",
             "agent": "scribe", "skills": [], "model": "fast",
             "phase": "docs", "est_hours": 1, "depends_on": ["e"],
             "reads": ["README.md"], "research": False,
             "done_when": "README.md has a Usage section"},
        ]
    else:
        return {"tasks": [], "project_complete": True}
    STATE["plans"][slug] = n + 1
    marker = os.environ.get("MOCK_TITLE_MARKER", "")
    if marker and n == 0:
        tasks[1]["title"] += " " + marker
    if os.environ.get("MOCK_GATE") and n == 0:
        tasks += [
            {"id": "h", "title": "Choose the paid data provider",
             "detail": "Record the chosen provider in docs/provider.md.",
             "why": "it costs money every month — that is the owner's call",
             "agent": "planner", "skills": [], "model": "",
             "phase": "decisions", "est_hours": 1, "depends_on": [],
             "reads": [], "research": False, "needs_human": True,
             "done_when": "docs/provider.md names the provider"},
            {"id": "i", "title": "Describe the provider setup",
             "detail": "Write docs/provider-setup.md for the chosen "
                       "provider.",
             "why": "follows from the owner's choice",
             "agent": "scribe", "skills": [], "model": "fast",
             "phase": "docs", "est_hours": 1, "depends_on": ["h"],
             "reads": [], "research": False,
             "done_when": "docs/provider-setup.md exists"}]
    if os.environ.get("MOCK_GATE") == "all" and n == 0:
        for t in tasks:
            t["needs_human"] = True
    if os.environ.get("MOCK_REPEAT") and n == 1:
        tasks.insert(0, {
            "id": "r", "title": "Write the design note",
            "detail": "Produce docs/design.md again.",
            "why": "the planner forgot it was done",
            "agent": "planner", "skills": [], "model": "", "phase": "design",
            "est_hours": 1, "depends_on": [], "reads": [], "research": False,
            "done_when": "docs/design.md exists"})
    if os.environ.get("MOCK_HARD") and n == 0:
        tasks[2]["hard"] = True         # the tests: "an ordinary model slips"
    # every task names its milestone, by the ids the ROADMAP section shows
    ids = re.findall(r"^[✓▶○–] (m\d+) ", prompt, re.M)
    place = {"a": 0, "b": 1, "c": 1, "d": 3, "e": 2, "f": 3, "r": 0}
    for t in tasks:
        at = place.get(t["id"])
        if ids and at is not None:
            t["milestone"] = ids[min(at, len(ids) - 1)]
    reached = ids[:2] if n >= 1 and not os.environ.get("MOCK_NO_REACHED") \
        else []
    return {"reached": reached, "tasks": tasks, "project_complete": False}


def roadmap(prompt):
    """The road for the mock's little project: four outcomes, the last two
    both hanging on the core."""
    if os.environ.get("MOCK_NO_ROADMAP"):
        return {"milestones": "I would rather not"}
    road = [
        {"id": "a", "title": "A design the build can follow",
         "outcome": "docs/design.md fixes inputs, outputs and layout",
         "depends_on": [], "est_tasks": 1},
        {"id": "b", "title": "A working, tested core",
         "outcome": "src/core.py runs and tests/test_core.py passes",
         "depends_on": ["a"], "est_tasks": 2},
        {"id": "c", "title": "Usable from the command line",
         "outcome": "src/cli.py starts the tool",
         "depends_on": ["b"], "est_tasks": 2},
        {"id": "d", "title": "Documented for its user",
         "outcome": "README.md says what it is and how to run it",
         "depends_on": ["b", "c"], "est_tasks": 2},
    ]
    done = re.search(r"ALREADY REACHED[^\n]*\n((?:- .*\n?)+)", prompt)
    have = {ln[2:].strip() for ln in (done.group(1) if done else "")
            .splitlines()}
    road = [m for m in road if m["title"] not in have]
    if "AN AUDIT FOUND THESE GAPS" in prompt:
        road.append({"id": "g", "title": "The audit's gaps closed",
                     "outcome": "what the audit listed exists",
                     "depends_on": [], "est_tasks": 1})
    return {"milestones": road}


def business_plan(prompt):
    """The sections the prompt asks for, each with a few lines of filler
    that show their arithmetic — and the one-line summary when asked."""
    if os.environ.get("MOCK_NO_BUSINESS"):
        return "I am not able to write that."
    asked = prompt.split("these sections:")[-1]
    heads = re.findall(r"^## (\d+\. [^\n]+)$", asked, re.M)
    out = []
    if "Begin with one line" in prompt:
        out.append("> **In one line:** For people who keep thousands of "
                   "photos: files named by the day they were taken, as a "
                   "small paid tool.")
    for h in heads:
        out.append(f"## {h}\n\nFor this project: an estimate, not a "
                   "finding. 40 customers x 9 a month = 360 a month, which "
                   "rests on the assumption that one in fifty who try it "
                   "pay. What is not known yet: whether they would.")
    return "\n\n".join(out)


def who_does_what(prompt):
    keys = re.findall(r"^- (\w+): ", prompt.split("PROPOSAL ITEMS")[-1], re.M)
    states = ("assumed", "missing", "there")
    return {
        "proposal": {k: {"state": states[i % 3],
                         "note": f"see the business plan on {k}"}
                     for i, k in enumerate(keys)},
        "aria": [
            {"title": "Compare the alternatives",
             "detail": "business/competitors.md: five alternatives, what "
                       "each costs and where it falls short",
             "why": "the price has to sit somewhere"},
            {"title": "Work out the break-even",
             "detail": "business/break-even.md: fixed costs, margin per "
                       "sale, sales needed a month", "why": "the money"},
            {"title": "Draft the interview guide",
             "detail": "business/interview-guide.md: ten questions about "
                       "the last time the problem happened",
             "why": "evidence of the problem"},
            {"title": "Draft the privacy notice",
             "detail": "business/privacy-notice.md", "why": "the rules"}],
        "you": [
            {"title": "Talk to five people who have this problem",
             "why": "only a person can have that conversation",
             "prepare": "the interview guide"},
            {"title": "Choose the name",
             "why": "it is your brand", "prepare": "a shortlist with the "
             "domains that are free"},
            {"title": "Decide whether to register a company",
             "why": "a legal act", "prepare": "what each form means for "
             "tax and liability"}]}


def review(prompt):
    """A code review of one file: the core module could document itself
    better; everything else is fine as it is."""
    path = re.search(r"THE FILE: (\S+)", prompt)
    path = path.group(1) if path else ""
    if re.search(r"(^|/)core\.py$", path):
        return {"findings": [{
            "kind": "docs", "where": "run()",
            "problem": "the docstring does not say what the result holds",
            "fix": "name the keys of the returned dict in the docstring",
            "risk": "safe", "severity": 2}]}
    return {"findings": []}


def refinement(prompt, title):
    """A refinement of the core module. Behaviour-preserving — unless the
    test wants to see a regression caught, on the first attempt."""
    key = _slug(prompt) + "/" + title
    STATE["attempts"][key] = attempt = STATE["attempts"].get(key, 0) + 1
    count = "len(items) + 1" if os.environ.get("MOCK_REFINE_BREAKS") \
        and attempt == 1 else "len(items)"
    body = ('"""Core module."""\n\n\ndef run(items):\n'
            '    """Summarise the items it is given.\n\n'
            "    Returns a dict with 'count' (how many) and 'items' (a "
            'list\n    copy of them).\n    """\n'
            f"    return {{'count': {count}, 'items': list(items)}}\n")
    return ("Refined as listed.\n\n```file:src/core.py\n" + body + "```\n\n"
            "## Notes\n\nI extended the docstring of `run()` and changed "
            "nothing else; its behaviour is the same.\n")


def task_output(prompt):
    title = re.search(r"YOUR TASK: (.+)", prompt)
    title = title.group(1).strip() if title else "task"
    if re.match(r"Refine (\S*/)?core\.py", title):
        return refinement(prompt, title)
    detail = re.search(r"Detail: (.+)", prompt)
    detail = detail.group(1) if detail else ""
    key = _slug(prompt) + "/" + title
    STATE["attempts"][key] = attempt = STATE["attempts"].get(key, 0) + 1
    paths = re.findall(r"\b((?:[\w.-]+/)*[\w.-]+\.(?:py|md|json|txt|sh))\b",
                       detail) or [f"docs/{_kebab(title)}.md"]
    path = paths[0]
    cited = " It draws on the research provided [1]." \
        if "RESEARCH MATERIAL" in prompt else ""
    owner = re.search(r"THE OWNER APPROVED THIS TASK WITH THIS DECISION: (.+)",
                      prompt)
    if owner:
        cited += f" Decision followed: {owner.group(1).strip()}."
    if path.endswith(".py"):
        if "[syntaxerror]" in title and attempt == 1:
            body = "def run(:\n    return 1\n"
        elif "test" in path:
            body = ("from src.core import run\n\n\n"
                    "def test_run_returns_dict():\n"
                    "    assert isinstance(run([]), dict)\n\n\n"
                    "def test_run_counts_items():\n"
                    "    assert run(['a', 'b'])['count'] == 2\n")
        elif "cli" in path:
            body = ("import sys\n\nfrom src.core import run\n\n\n"
                    "def main():\n    print(run(sys.argv[1:]))\n\n\n"
                    "if __name__ == '__main__':\n    main()\n")
        else:
            body = ('"""Core module."""\n\n\ndef run(items):\n'
                    '    """Summarise the items it is given."""\n'
                    "    return {'count': len(items), "
                    "'items': list(items)}\n")
        fence, lang = "```", ""
    elif path.endswith(".json"):
        body, fence = json.dumps({"title": title, "ok": True}, indent=2) \
            + "\n", "```"
    else:
        existing = ""
        m = re.search(rf"--- {re.escape(path)} ---\n(.*?)(?=\n--- |\n\n[A-Z]"
                      r"{3,}|\Z)", prompt, re.S)
        if m:
            existing = m.group(1).strip() + "\n\n"
        heading = "Troubleshooting" if "troubleshooting" in title.lower() \
            else ("Usage" if "command line" in title.lower()
                  or "usage" in title.lower() else title)
        body = (existing + f"## {heading}\n\n" if existing
                else f"# {title}\n\n") + (
            f"This document was produced for the task “{title}”.{cited}\n\n"
            "```bash\npython -m src.cli one two\n```\n\n"
            "- Inputs: a list of items\n- Outputs: a summary\n"
            "- Layout: `src/core.py`, `src/cli.py`, `tests/`\n")
        fence = "````"
    return (f"Here is the finished work.\n\n{fence}file:{path}\n{body}"
            f"{fence}\n\n## Notes\n\nI wrote `{path}` as the task asked. "
            "I kept it small on purpose so it is easy to verify, and relied "
            f"on the project files I was shown.{cited}\n")


def verdict(prompt):
    title = re.search(r"TASK: (.+)", prompt)
    title = title.group(1).strip() if title else ""
    key = "verify/" + title
    STATE["attempts"][key] = n = STATE["attempts"].get(key, 0) + 1
    if "[fail]" in title or os.environ.get("MOCK_FAIL_ALL"):
        return {"pass": False, "feedback": "the work does not meet the "
                                           "criterion (mock: always fails)"}
    if "[flaky]" in title and n == 1:
        return {"pass": False, "feedback": "the usage example is missing"}
    if "[stubborn]" in title and n <= 2:
        return {"pass": False, "feedback": "the edge cases are not handled"}
    return {"pass": True, "feedback": "meets the done-when criterion"}


def audit(prompt):
    slug = "audit"
    STATE["audits"][slug] = n = STATE["audits"].get(slug, 0) + 1
    if os.environ.get("MOCK_AUDIT_GAPS") and n == 1:
        return {"met": False,
                "gaps": ["there is no note on known limitations"]}
    return {"met": True, "gaps": []}


def memory(prompt):
    batch = re.search(r"THIS BATCH[^\n]*\n(.*?)\n\nFILES NOW", prompt, re.S)
    lines = (batch.group(1).strip().splitlines() if batch else [])[:6]
    return ("## State of the project\nThe files listed under FILES NOW "
            "exist and were verified.\n\n## Decisions made\n- Keep it a "
            "single small Python package.\n\n## Lessons\n- Small files pass "
            "review first time.\n\n## Still to do\n"
            + ("\n".join(lines) if lines else "- nothing queued") + "\n")


def reply_for(system, prompt):
    s, p = " ".join((system or "").split()), prompt or ""
    if "triage classifier" in s:
        return json.dumps(triage(p))
    if "You write concise project plans from raw idea notes" in s:
        return proposed_plan(p)
    if "You turn a research need into web search queries" in s:
        words = [w for w in re.findall(r"[a-z]{4,}", p.lower())
                 if w not in ("research", "need")][:5]
        return json.dumps({"queries": [" ".join(words) or "idea prior art"]})
    if "lead planner, about to run a project autonomously" in s:
        return assessment(p)
    if "You write the business plan for a project idea" in s:
        return business_plan(p)
    if "into who does what" in s:
        if os.environ.get("MOCK_NO_ACTIONS"):
            return "The lists are in my head; I would rather talk it through."
        return json.dumps(who_does_what(p))
    if "Lay out the WHOLE road" in s:
        return json.dumps(roadmap(p))
    if "You are the project planner inside A.R.I.A." in s:
        if os.environ.get("MOCK_NO_PLAN"):      # a planner that only talks
            return ("I would start with the design, then the core module, "
                    "and write the tests last.")
        return json.dumps(plan_batch(p))
    if "verification judge" in s:
        return json.dumps(verdict(p))
    if "You audit whether a project's requirements are met" in s:
        return json.dumps(audit(p))
    if "reviewing ONE file of a working project" in s:
        return json.dumps(review(p))
    if "working memory of an autonomous project" in s:
        return memory(p)
    if "opening summary of a report" in s:
        return ("The run completed its planned work: the design, the core "
                "module, its tests and the documentation were written and "
                "verified. Nothing was executed, so run the tests once "
                "before relying on it.")
    if "answering a question from live web research" in s:
        return ("Based on what I found, the short answer is yes — the "
                "sources describe it directly [1].")
    if "summarising a web page" in s:
        return ("The page is a short reference on the topic; its key "
                "points are the ones in its headings.")
    if "YOUR TASK:" in p:
        return task_output(p)
    if p.startswith("From prior knowledge only") \
            or p.startswith("Using the live web research"):
        return research(p)
    if "You are A.R.I.A. (Autonomous Reasoning" in s:
        if "[slow]" in p:               # a model that is busy elsewhere
            time.sleep(float(os.environ.get("MOCK_SLOW_SECONDS") or 6))
        return "All systems are operational and I'm ready when you are."
    if "specialist agent inside A.R.I.A." in s:
        return ("Here is my finished work on that. The main point stands "
                "on its own; the one thing to verify is the estimate.")
    return "Understood."


# ------------------------------------------------------------ the server

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass

    def _json(self, obj, code=200):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/health":       # llama-server's readiness probe
            if time.time() - STARTED < LOAD_SECONDS:
                self._json({"error": {"code": 503,
                                      "message": "Loading model"}}, 503)
            else:
                self._json({"status": "ok"})
        elif self.path == "/api/tags":
            self._json({"models": [{"name": n, "size": s}
                                   for n, s in MODELS]})
        elif self.path == "/api/ps":     # what Ollama has in memory now
            self._json({"models": [{"name": n} for n in STATE["loaded"]]})
        elif self.path == "/v1/models":
            self._json({"data": [{"id": n} for n, _ in MODELS]})
        elif self.path == "/mock/calls":
            self._json({"calls": STATE["calls"][-200:],
                        "released": STATE["released"],
                        "loaded": STATE["loaded"]})
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = json.loads(self.rfile.read(length) or b"{}")
        if self.path == "/mock/reset":
            for key in ("plans", "attempts", "audits"):
                STATE[key].clear()
            STATE["calls"].clear()
            return self._json({"ok": True})
        if self.path == "/api/generate":  # keep_alive 0: "let go of it"
            name = body.get("model", "")
            if body.get("keep_alive") == 0 and name in STATE["loaded"]:
                STATE["loaded"].remove(name)
                STATE["released"].append(name)
            return self._json({"done": True})
        messages = body.get("messages") or []
        system = " ".join(m.get("content", "") for m in messages
                          if m.get("role") == "system")
        prompt = next((m.get("content", "") for m in reversed(messages)
                       if m.get("role") == "user"), "")
        model = body.get("model", "")
        if self.path == "/api/chat" and not any(
                model == n or n.startswith(model + ":") for n, _ in MODELS):
            return self._json({"error": f"model '{model}' not found"}, 404)
        if "think" in body and os.environ.get("MOCK_NO_THINK_SWITCH"):
            return self._json({"error": "json: unknown field \"think\""}, 400)
        text = reply_for(system, prompt)
        options = body.get("options") or {}
        ollama = self.path == "/api/chat"
        reasoning, text, ended, read, wrote = fit(
            sum(len(m.get("content") or "") for m in messages), text,
            int(options.get("num_ctx") or 0) if ollama else WINDOW,
            options.get("num_predict") if ollama else 0,
            body.get("think") is not False)
        STATE["calls"].append({"model": model, "system": system[:80],
                               "num_ctx": options.get("num_ctx"),
                               "num_predict": options.get("num_predict"),
                               "think": body.get("think", "unset"),
                               "reasoned": len(reasoning), "ended": ended,
                               "chars": len(prompt)})

        def pieces(whole):
            return [whole[i:i + 24] for i in range(0, len(whole), 24)]

        self.send_response(200)
        self.send_header("Connection", "close")
        if ollama:
            self.send_header("Content-Type", "application/x-ndjson")
            self.end_headers()
            for kind, whole in (("thinking", reasoning), ("content", text)):
                for c in pieces(whole) or ([""] if kind == "content" else []):
                    self.wfile.write(json.dumps(
                        {"message": {"role": "assistant", "content": "",
                                     kind: c},
                         "done": False}).encode() + b"\n")
                    self.wfile.flush()
                    if DELAY:
                        time.sleep(DELAY)
            self.wfile.write(json.dumps(
                {"message": {"role": "assistant", "content": ""},
                 "done": True, "done_reason": ended,
                 "prompt_eval_count": read, "eval_count": wrote,
                 # forty tokens a second, in nanoseconds
                 "eval_duration": int(wrote / 40 * 1e9)}).encode() + b"\n")
        elif self.path == "/v1/chat/completions":
            self.send_header("Content-Type", "text/event-stream")
            self.end_headers()
            for kind, whole in (("reasoning_content", reasoning),
                                ("content", text)):
                for c in pieces(whole) or ([""] if kind == "content" else []):
                    self.wfile.write(b"data: " + json.dumps(
                        {"choices": [{"delta": {kind: c}}]}).encode()
                        + b"\n\n")
                    self.wfile.flush()
                    if DELAY:
                        time.sleep(DELAY)
            self.wfile.write(b"data: " + json.dumps(
                {"choices": [{"delta": {}, "finish_reason": ended}],
                 "timings": {"prompt_n": read, "predicted_n": wrote,
                             "predicted_per_second": 1.5}}).encode()
                + b"\n\n")
            self.wfile.write(b"data: [DONE]\n\n")
        self.close_connection = True


def main():
    port = int(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].isdigit() \
        else 11435
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print(f"aria-mock-llm -> http://127.0.0.1:{port}  (Ctrl+C to stop)",
          flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


if __name__ == "__main__":
    main()
