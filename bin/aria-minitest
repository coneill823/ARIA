#!/usr/bin/env python3
"""aria-minitest — run a project's Python tests when pytest is not installed.

  aria-minitest [folder]        default: the current directory

A.R.I.A. runs a project's tests in a sandbox after every change. With
pytest installed that is `python -m pytest`; without it, this: plain
`def test_…()` functions and unittest.TestCase classes in test_*.py /
*_test.py files, run with nothing but the standard library. A test that
needs pytest itself (fixtures, parametrize, `import pytest`) is reported
as skipped — it is not counted as passing.

Exit code: 0 all that ran passed · 1 something failed · 5 nothing ran.
"""

import importlib.util
import inspect
import os
import re
import sys
import traceback
import unittest

SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", "venv",
             "autopilot", ".aria", "build", "dist", "target", ".tox"}


def find(root):
    out = []
    for folder, dirs, files in os.walk(root):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS
                         and not d.startswith("."))
        for name in sorted(files):
            if re.fullmatch(r"(test_.*|.*_test)\.py", name):
                out.append(os.path.join(folder, name))
    return out


def load(path, root):
    rel = os.path.relpath(path, root)
    name = "minitest_" + re.sub(r"\W", "_", rel[:-3])
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def main():
    root = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else ".")
    os.chdir(root)
    for extra in (root, os.path.join(root, "src")):
        if os.path.isdir(extra) and extra not in sys.path:
            sys.path.insert(0, extra)
    passed, failed, skipped = 0, [], []
    for path in find(root):
        rel = os.path.relpath(path, root)
        try:
            module = load(path, root)
        except ModuleNotFoundError as exc:
            if exc.name == "pytest":
                skipped.append(f"{rel} (needs pytest)")
                continue
            failed.append((rel, traceback.format_exc()))
            continue
        except Exception:
            failed.append((rel, traceback.format_exc()))
            continue
        for name, fn in sorted(vars(module).items()):
            if name.startswith("test") and inspect.isfunction(fn) \
                    and fn.__module__ == module.__name__:
                needs = [p for p in inspect.signature(fn).parameters.values()
                         if p.default is p.empty
                         and p.kind in (p.POSITIONAL_ONLY,
                                        p.POSITIONAL_OR_KEYWORD)]
                if needs:
                    skipped.append(f"{rel}::{name} (needs pytest: fixture "
                                   f"{needs[0].name})")
                    continue
                try:
                    fn()
                    passed += 1
                    print(f"ok    {rel}::{name}")
                except Exception:
                    failed.append((f"{rel}::{name}", traceback.format_exc()))
                    print(f"FAIL  {rel}::{name}")
        suite = unittest.defaultTestLoader.loadTestsFromModule(module)
        if suite.countTestCases():
            result = unittest.TestResult()
            suite.run(result)
            bad = result.failures + result.errors
            passed += result.testsRun - len(bad) - len(result.skipped)
            for case, trace in bad:
                failed.append((f"{rel}::{case.id().split('.', 1)[-1]}", trace))
                print(f"FAIL  {rel}::{case.id().split('.', 1)[-1]}")
            for case, why in result.skipped:
                skipped.append(f"{rel}::{case.id().split('.', 1)[-1]} ({why})")
    for where, trace in failed:
        print(f"\n--- {where}\n{trace.rstrip()}")
    for item in skipped:
        print(f"skip  {item}")
    print(f"\n{passed} passed, {len(failed)} failed"
          + (f", {len(skipped)} skipped" if skipped else ""))
    if skipped:
        print("(run by aria-minitest; install pytest for the skipped ones)")
    if failed:
        return 1
    return 0 if passed else 5


if __name__ == "__main__":
    sys.exit(main())
