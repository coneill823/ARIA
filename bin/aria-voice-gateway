#!/usr/bin/env python3
"""aria-voice-gateway — one authenticated door for voice assistants.

  aria voice-gateway [port]     default 8701, binds 127.0.0.1
  aria voice-gateway token      print the shared secret (create it if new)

A.R.I.A.'s own server has no login and must never be exposed. This is the
only thing a tunnel should ever point at. It accepts exactly two requests:

  POST /say     X-Aria-Token: <secret>     {"text": "what are you working on"}
  ->            {"reply": "…"}
      for anything that can send a header: a script, a phone shortcut,
      Home Assistant, an AWS Lambda.

  POST /alexa/<secret>                     an Alexa skill request, as Amazon
  ->            an Alexa response           sends it
      so an Alexa skill's endpoint can be this machine itself — no Lambda
      in between. The secret is part of the address you give Amazon; the
      request must also be fresh (Alexa stamps it), and, once you have run
      `aria alexa skill <id>`, come from your own skill.

Both check the secret and pass what was said to the local server's
/api/say. Everything else — every other path, every other method — is a
404.

What it will not do, even with the right secret: approve a plan, answer a
task that is waiting on your decision, or push to GitHub. Those answer "do
that in the app" — the human gate is not something a voice in the room (or
a leaked URL) gets to open. Set ARIA_VOICE_ALLOW=all to lift that if you
really want it.

Limits: 30 requests a minute; 600 characters of text; five wrong secrets
lock the door for a minute; Alexa's eight-second patience is respected
(slow answers get "still working on it" instead of an error).

The secret is ARIA_VOICE_TOKEN from the environment, else the file
system/voice-token (created on first run, readable only by you, ignored by
git).
"""

import datetime
import hmac
import importlib.util
import json
import os
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import aria_engine as eng  # noqa: E402

UPSTREAM = os.environ.get("ARIA_URL", "http://127.0.0.1:8700").rstrip("/")
GATED = set() if os.environ.get("ARIA_VOICE_ALLOW", "").lower() == "all" \
    else {"approve", "task-decision", "github-push"}
MAX_TEXT = 600
PER_MINUTE = 30
PATIENCE = 7.0                 # Alexa gives up at about eight seconds
FRESH = 150                    # seconds an Alexa request stays acceptable
REFUSAL = ("That one is yours to do in the app — approving a plan, deciding "
           "a task that waits on you and pushing to GitHub aren't things I "
           "take by voice.")

_lock = threading.Lock()
_hits = []                     # timestamps of accepted requests
_fails = {"count": 0, "until": 0.0}


def token():
    return eng.voice_token()


def skill():
    """The Alexa skill logic — the same file a Lambda would run."""
    spec = importlib.util.spec_from_file_location(
        "aria_alexa_skill",
        eng.ROOT / "integrations" / "alexa" / "lambda_function.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def answer(text):
    """What she says to `text` from a voice in the room: the gate stays
    shut, everything else goes to the local server."""
    text = " ".join(str(text).split())[:MAX_TEXT]
    if not text:
        return "I didn't catch that."
    intent = eng.detect_intent(text)
    if intent and intent["action"] in GATED:
        return REFUSAL
    print(f"voice: {text[:80]!r}", flush=True)
    return ask(text)


def fresh(event):
    """Is an Alexa request recent? (Amazon stamps each one; an old one is
    a replay.)"""
    stamp = str((event.get("request") or {}).get("timestamp") or "")
    try:
        sent = datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except ValueError:
        return False
    if sent.tzinfo is None:
        sent = sent.replace(tzinfo=datetime.timezone.utc)
    age = (datetime.datetime.now(datetime.timezone.utc) - sent).total_seconds()
    return abs(age) <= FRESH


def ask(text):
    """Forward to the local server; never raise, never keep Alexa waiting."""
    req = urllib.request.Request(
        UPSTREAM + "/api/say",
        # she is told how long the caller can wait, and answers "I'm busy
        # with …" herself rather than leave the line silent
        data=json.dumps({"text": text, "patience": PATIENCE - 2}).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=PATIENCE) as resp:
            return json.load(resp).get("reply") or "Done."
    except TimeoutError:
        return ("That's taking longer than I can hold the line for — the "
                "answer will be in the app.")
    except urllib.error.URLError as exc:
        if isinstance(getattr(exc, "reason", None), TimeoutError):
            return ("That's taking longer than I can hold the line for — "
                    "the answer will be in the app.")
        return "I can't reach the A.R.I.A. server right now."
    except Exception:
        return "Something went wrong passing that along."


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "aria-voice"
    sys_version = ""

    def log_message(self, *args):
        pass

    def reply(self, code, obj):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        self.reply(404, {"error": "not found"})

    do_PUT = do_DELETE = do_PATCH = do_HEAD = do_OPTIONS = do_GET

    def do_POST(self):
        path = self.path.split("?")[0]
        alexa = path.startswith("/alexa/")
        if path != "/say" and not alexa:
            return self.reply(404, {"error": "not found"})
        now = time.time()
        with _lock:
            if _fails["until"] > now:
                return self.reply(429, {"error": "locked — try again later"})
        given = path[len("/alexa/"):] if alexa \
            else self.headers.get("X-Aria-Token", "")
        if not hmac.compare_digest(given.encode(), token().encode()):
            with _lock:
                _fails["count"] += 1
                if _fails["count"] >= 5:
                    _fails.update(count=0, until=now + 60)
            return self.reply(403, {"error": "forbidden"})
        with _lock:
            _fails["count"] = 0
            _hits[:] = [t for t in _hits if now - t < 60]
            if len(_hits) >= PER_MINUTE:
                return self.reply(429, {"error": "slow down"})
            _hits.append(now)
        try:
            length = int(self.headers.get("Content-Length") or 0)
            if length > (65536 if alexa else 4096):
                return self.reply(413, {"error": "too large"})
            body = json.loads(self.rfile.read(length) or b"{}")
            if not isinstance(body, dict):
                raise ValueError
        except (ValueError, AttributeError):
            return self.reply(400, {"error": "send JSON: {\"text\": \"…\"}"})
        if alexa:
            return self.alexa(body)
        text = " ".join(str(body.get("text", "")).split())[:MAX_TEXT]
        if not text:
            return self.reply(400, {"error": "text required"})
        self.reply(200, {"reply": answer(text)})

    def alexa(self, event):
        """An Alexa skill request, straight from Amazon."""
        if not fresh(event):
            return self.reply(400, {"error": "stale or unstamped request"})
        try:
            logic = skill()
        except Exception as exc:        # e.g. the integrations folder is gone
            print(f"voice: cannot load the Alexa skill logic — {exc}",
                  flush=True)
            return self.reply(500, {"error": "the Alexa skill logic "
                                             "(integrations/alexa/) is missing"})
        want = eng.config().get("alexa_skill_id", "")
        if want and logic.skill_id_of(event) != want:
            return self.reply(403, {"error": "not your skill"})
        try:
            self.reply(200, logic.handle(event, answer))
        except Exception:
            self.reply(200, logic.speak("Something went wrong on my side.",
                                        end=True))


def main():
    args = sys.argv[1:]
    if args[:1] == ["token"]:
        print(token())
        return 0
    port = int(args[0]) if args and args[0].isdigit() else 8701
    token()                                       # create it before serving
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print(f"A.R.I.A. voice gateway -> http://127.0.0.1:{port}/say and "
          f"/alexa/<secret>  (forwards to {UPSTREAM}; setting it up: "
          "aria alexa)", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
