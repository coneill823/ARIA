#!/usr/bin/env bash
# aria-llama — llama.cpp (Vulkan) helper for the RX 9070 XT-class setup:
# llama-server speaks the OpenAI API, so once it's serving a model you just
# set a tier in system/config.yml, e.g.  smart: llamacpp/qwen3-30b
#
#   aria-llama install             fetch a prebuilt Vulkan llama.cpp build
#   aria-llama build               build llama-server from source (fallback)
#   aria-llama get <url> [name]    download a GGUF into vendor/models/
#                                  (resumes; HuggingFace "resolve" URLs work)
#   aria-llama serve <preset|gguf> run llama-server on :8080
#   aria-llama service <preset>    install a systemd user service for it
#
# A distro-packaged llama-server also works: anything on PATH is detected
# (e.g. pacman -Ss llama.cpp — pick the vulkan variant). And for GIANT
# models the GPU barely matters (experts stream from disk), so even a
# CPU-only llama-server build is fine there.
#
# Presets (tuned for 16GB VRAM + 64GB RAM; models are MoE so the expert
# weights can live in system RAM via --n-cpu-moe):
#   smart   vendor/models/smart.gguf  — e.g. Qwen3-30B-A3B class (~19GB)
#           flags: -ngl 999 --n-cpu-moe 8
#   deep    vendor/models/deep.gguf   — e.g. gpt-oss-120b class (~63GB)
#           flags: -ngl 999 --n-cpu-moe 30
#   giant   vendor/models/giant.gguf  — BIGGER THAN RAM (DeepSeek 671B,
#           Kimi K2 1T...): every expert on CPU, weights mmap-streamed
#           from NVMe by the OS. Works, but think 0.5-2 tok/s — run it as
#           the `deep` tier for overnight planning, not chat. Needs the
#           low-bit "dynamic" quants (see docs/BIG-MODELS.md); for a
#           multi-part GGUF pass the first part's path to `serve`.
# Download e.g.:
#   aria-llama get https://huggingface.co/unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF/resolve/main/Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf smart.gguf
# If VRAM overflows raise the --n-cpu-moe number (env: ARIA_NCPU_MOE);
# if there's VRAM to spare, lower it for more speed.
#
# Simplest alternative (no llama.cpp): let Ollama manage big models —
#   ollama pull qwen3:30b && ollama pull gpt-oss:120b
# — but NOT giant ones: Ollama disables mmap on CPU loads, so
# larger-than-RAM models need this script (or colibri) instead.
set -euo pipefail

ARIA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENDOR="$ARIA_ROOT/vendor/llama.cpp"
MODELS="$ARIA_ROOT/vendor/models"
PORT="${ARIA_LLAMACPP_PORT:-8080}"
CTX="${ARIA_LLAMACPP_CTX:-16384}"

usage() { sed -n '2,38p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

server_bin() {
  for b in "$VENDOR/bin/llama-server" "$VENDOR/llama-server" \
           "$VENDOR/build/bin/llama-server" \
           "$ARIA_ROOT/vendor/llama.cpp-src/build/bin/llama-server" \
           "$(command -v llama-server 2>/dev/null || true)"; do
    [ -n "$b" ] && [ -x "$b" ] && { echo "$b"; return; }
  done
  return 1
}

link_server() {
  # the release archives change their internal layout between versions —
  # find the binary wherever it landed and link it to the known spot
  found="$(find "$VENDOR" -maxdepth 5 -type f -name llama-server \
             -not -path "$VENDOR/bin/*" 2>/dev/null | head -1 || true)"
  [ -n "$found" ] || return 1
  chmod +x "$found" 2>/dev/null || true
  mkdir -p "$VENDOR/bin"
  ln -sfn "$found" "$VENDOR/bin/llama-server"
  return 0
}

cmd="${1:-}"; shift || true
case "$cmd" in
  install)
    if server_bin >/dev/null 2>&1; then
      echo "llama-server already available: $(server_bin)"; exit 0
    fi
    if link_server; then
      echo "found an already-extracted binary — linked: $(server_bin)"
      "$(server_bin)" --version 2>/dev/null || true
      exit 0
    fi
    mkdir -p "$VENDOR"
    echo "searching recent llama.cpp builds for a Vulkan linux binary…"
    # binaries live in nightly releases (bNNNN tags), not releases/latest
    url="$(curl -fsSL \
      "https://api.github.com/repos/ggml-org/llama.cpp/releases?per_page=15" \
      2>/dev/null \
      | grep -o '"browser_download_url": *"[^"]*bin-ubuntu-vulkan-x64[^"]*"' \
      | head -1 | sed 's/.*"\(https[^"]*\)"/\1/' || true)"
    if [ -z "$url" ]; then
      echo "couldn't find a prebuilt Vulkan asset via the GitHub API." >&2
      echo "easiest alternatives:" >&2
      echo "  1) distro package:   pacman -Ss llama.cpp   — install the" >&2
      echo "     vulkan variant; a 'llama-server' on PATH is auto-detected" >&2
      echo "  2) build from source: aria-llama build" >&2
      exit 1
    fi
    file="$VENDOR/$(basename "${url%%\?*}")"
    echo "downloading $(basename "$file")"
    curl -fL --progress-bar -o "$file" "$url"
    case "$file" in
      *.tar.gz|*.tgz) tar -xzf "$file" -C "$VENDOR" ;;
      *.zip)          unzip -oq "$file" -d "$VENDOR" ;;
      *) echo "unknown archive type: $file" >&2; exit 1 ;;
    esac
    rm -f "$file"
    link_server || true
    bin="$(server_bin)" || {
      echo "extracted, but llama-server not found — try: aria-llama build" >&2
      exit 1
    }
    echo "installed -> $bin"
    "$bin" --version 2>/dev/null || true
    echo "note: needs Vulkan drivers (on Arch: vulkan-radeon)"
    ;;

  build)
    command -v cmake >/dev/null 2>&1 || {
      echo "needs cmake (and for Vulkan: headers + shader tooling)." >&2
      echo "on Arch: sudo pacman -S --needed cmake vulkan-headers shaderc \\" >&2
      echo "         spirv-headers spirv-tools glslang" >&2
      exit 1
    }
    SRC="$ARIA_ROOT/vendor/llama.cpp-src"
    if [ -d "$SRC/.git" ]; then
      git -C "$SRC" pull --ff-only
    else
      git clone --depth 1 https://github.com/ggml-org/llama.cpp "$SRC"
    fi
    vk=ON
    command -v glslc >/dev/null 2>&1 || {
      echo "glslc (shaderc) not found — building CPU-only llama-server."
      echo "(fine for giant models; install shaderc and rerun for Vulkan)"
      vk=OFF
    }
    cmake -S "$SRC" -B "$SRC/build" -DGGML_VULKAN=$vk -DCMAKE_BUILD_TYPE=Release
    cmake --build "$SRC/build" --target llama-server -j"$(nproc)"
    echo "built -> $SRC/build/bin/llama-server (auto-detected by serve)"
    ;;

  get)
    url="${1:-}"; name="${2:-}"
    [ -n "$url" ] || { echo "usage: aria-llama get <gguf-url> [saved-name]"; exit 1; }
    mkdir -p "$MODELS"
    [ -n "$name" ] || name="$(basename "${url%%\?*}")"
    echo "downloading to vendor/models/$name (resumable — rerun if interrupted)"
    curl -fL -C - --progress-bar -o "$MODELS/$name" "$url"
    echo "done: $MODELS/$name"
    ;;

  serve)
    what="${1:-smart}"
    bin="$(server_bin)" || { echo "run 'aria-llama install' first" >&2; exit 1; }
    giant=0
    case "$what" in
      smart) gguf="$MODELS/smart.gguf"; ncpu="${ARIA_NCPU_MOE:-8}" ;;
      deep)  gguf="$MODELS/deep.gguf";  ncpu="${ARIA_NCPU_MOE:-30}" ;;
      giant) gguf="${2:-$MODELS/giant.gguf}"; ncpu="${ARIA_NCPU_MOE:-999}"
             giant=1 ;;
      *)     gguf="$what";              ncpu="${ARIA_NCPU_MOE:-0}" ;;
    esac
    [ -f "$gguf" ] || { echo "model not found: $gguf (use 'aria-llama get …')" >&2; exit 1; }
    moe_flags=""
    [ "$ncpu" -gt 0 ] 2>/dev/null && moe_flags="--n-cpu-moe $ncpu"
    if [ "$giant" = 1 ]; then
      # larger-than-RAM: keep mmap ON so the OS streams expert weights
      # from NVMe; small context + quantized KV cache to save real RAM
      ctx="${ARIA_LLAMACPP_CTX:-8192}"
      echo "serving GIANT $(basename "$gguf") on http://127.0.0.1:$PORT"
      echo "weights stream from disk — expect ~0.5-2 tok/s; first reply is slowest"
      exec "$bin" -m "$gguf" --host 127.0.0.1 --port "$PORT" \
        -ngl 999 --n-cpu-moe 999 --ctx-size "$ctx" \
        --cache-type-k q8_0 --cache-type-v q8_0 --jinja
    fi
    echo "serving $(basename "$gguf") on http://127.0.0.1:$PORT (OpenAI API)"
    echo "flags: -ngl 999 $moe_flags --ctx-size $CTX"
    exec "$bin" -m "$gguf" --host 127.0.0.1 --port "$PORT" \
      -ngl 999 $moe_flags --ctx-size "$CTX" --jinja
    ;;

  service)
    what="${1:-smart}"
    server_bin >/dev/null || { echo "run 'aria-llama install' first" >&2; exit 1; }
    SYSD="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    mkdir -p "$SYSD"
    cat > "$SYSD/aria-llama.service" <<UNIT
[Unit]
Description=A.R.I.A. llama.cpp server ($what)

[Service]
ExecStart=$ARIA_ROOT/bin/aria-llama serve $what
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT
    systemctl --user daemon-reload
    systemctl --user enable --now aria-llama.service
    echo "aria-llama.service enabled (serving '$what' at login)"
    echo "logs: journalctl --user -u aria-llama -f"
    ;;

  ""|-h|--help|help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 1 ;;
esac
